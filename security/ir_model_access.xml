<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         FMS Model Access Control (Spec Section 9.1)

         Three groups with escalating rights:
           Attendant   — R on shifts; RC on entries (meter/dip/cash own lines)
           Supervisor  — Full CRUD on all mutable models; no delete on closed
           Accountant  — Read-only on everything (plus implied Supervisor rights)

         Immutable log models (fms.meter_log, fms.dip_log) block write/unlink
         at ORM level regardless of ACL — the ACL here gives create (for the
         close action) but the model's write/unlink override raises ValidationError.
    ================================================================ -->

    <!-- ── fms.shift ─────────────────────────────────────────────────── -->
    <record id="access_fms_shift_attendant" model="ir.model.access">
        <field name="name">fms.shift attendant read</field>
        <field name="model_id" ref="model_fms_shift"/>
        <field name="group_id" ref="group_fms_attendant"/>
        <field name="perm_read"   eval="1"/>
        <field name="perm_write"  eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_fms_shift_supervisor" model="ir.model.access">
        <field name="name">fms.shift supervisor full</field>
        <field name="model_id" ref="model_fms_shift"/>
