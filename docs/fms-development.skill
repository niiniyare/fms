## Pattern 7: Unit Testing (pytest)

**Use Case:** Test models and business logic

```python
from odoo.tests import TransactionCase

class TestResidualAllocation(TransactionCase):
    
    @classmethod
    def setUpClass(cls):
        super().setUpClass()
        cls.shift = cls.env["fms.shift"].create({
            "shift_date": "2026-01-15",
            "shift_label": "1_day",
            "supervisor_id": cls.env["hr.employee"].create({"name": "Supervisor"}).id,
        })
    
    def test_diesel_over_reported_ux_under_reported(self):
        """Diesel -100L over, UX +240L under → allocate 104L"""
        # Create products
        diesel = self.env["product.product"].create({
            "name": "Diesel",
            "fms_is_fuel": True,
        })
        ux = self.env["product.product"].create({
            "name": "Unleaded",
            "fms_is_fuel": True,
        })
        
        # Create product sales (simulated)
        self.env["fms.shift.product.sales"].create({
            "shift_id": self.shift.id,
            "product_id": diesel.id,
            "meter_amount": 222800,
            "accounted_amount": 230000,  # Over by 7200
        })
        self.env["fms.shift.product.sales"].create({
            "shift_id": self.shift.id,
            "product_id": ux.id,
            "meter_amount": 107000,
            "accounted_amount": 100000,  # Under by 7000
        })
        
        # Trigger allocation
        self.shift._calculate_residuals()
        
        # Verify
        allocations = self.shift.residual_allocation_line_ids
        self.assertEqual(len(allocations), 1)
        
        alloc = allocations[0]
        self.assertEqual(alloc.from_product_id, diesel)
        self.assertEqual(alloc.to_product_id, ux)
        self.assertAlmostEqual(alloc.amount, 7000, places=2)
    
    def test_fc_cash_hard_gate(self):
        """Shift refuses to close if FC Cash ≠ 0"""
        self.shift.fc_cash_balance = 50.00  # Non-zero
        
        with self.assertRaises(ValidationError):
            self.shift.action_close_shift()
    
    def test_immutable_log(self):
        """Meter logs cannot be edited after creation"""
        log = self.env["fms.meter.log"].create({
            "shift_id": self.shift.id,
            "pump_id": self.env["fms.pump"].create({"name": "UX5"}).id,
            "nozzle_id": self.env["fms.pump.nozzle"].create({
                "pump_id": self.env["fms.pump"].search([], limit=1).id,
            }).id,
            "opening_elec_vol": 450000,
            "closing_elec_vol": 450500,
        })
        
        with self.assertRaises(ValidationError):
            log.write({"closing_elec_vol": 450600})
        
        with self.assertRaises(ValidationError):
            log.unlink()
```

**Key Points:**
- Use `TransactionCase` (has DB access)
- Use `setUpClass()` for expensive setup
- Test happy path + edge cases + error cases
- Use `assertRaises()` for exceptions
- Use `assertAlmostEqual()` for floats (avoid rounding errors)
- Each test should be independent & idempotent

