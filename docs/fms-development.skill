## Pattern 5: Journal Entry Posting

**Use Case:** Post GL entries from FMS shift data

```python
def _post_sales_journal(self):
    """Post daily sales journal: DR COGS | CR Revenue"""
    lines = []
    
    for prod_sales in self.product_sales_line_ids:
        cogs_acct = self._get_cogs_account(prod_sales.product_id)
        revenue_acct = self._get_revenue_account(prod_sales.product_id)
        
        lines.append((0, 0, {
            "account_id": cogs_acct.id,
            "debit": prod_sales.meter_amount,
        }))
        lines.append((0, 0, {
            "account_id": revenue_acct.id,
            "credit": prod_sales.meter_amount,
        }))
    
    if lines:
        move = self.env["account.move"].create({
            "move_type": "entry",
            "date": self.shift_date,
            "ref": f"Shift sales — {self.name}",
            "line_ids": lines,
            "journal_id": self._get_sales_journal().id,
            "company_id": self.company_id.id,
        })
        move.action_post()
        self.journal_entry_id = move.id

def _post_residual_allocation_journal(self):
    """Post residual reallocation: DR from_product COGS | CR to_product COGS"""
    lines = []
    
    for alloc in self.residual_allocation_line_ids:
        from_cogs = self._get_cogs_account(alloc.from_product_id)
        to_cogs = self._get_cogs_account(alloc.to_product_id)
        
        lines.append((0, 0, {
            "account_id": from_cogs.id,
            "credit": alloc.amount,  # Reduce COGS (wasn't really sold)
        }))
        lines.append((0, 0, {
            "account_id": to_cogs.id,
            "debit": alloc.amount,  # Increase COGS (actually sold)
        }))
    
    if lines:
        move = self.env["account.move"].create({
            "move_type": "entry",
            "date": self.shift_date,
            "ref": f"Residual allocation — {self.name}",
            "line_ids": lines,
            "journal_id": self._get_sales_journal().id,
            "company_id": self.company_id.id,
        })
        move.action_post()
```

**Key Points:**
- Create one journal per transaction type (sales, residuals, variances)
- Always call `action_post()` to move from Draft to Posted
- Use `move_type = "entry"` for internal transfers
- Store journal ID on shift for audit trail
- Catch duplicate posting (check for existing journal_entry_id)

