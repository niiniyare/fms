<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Activate KES currency -->
        <record id="base.KES" model="res.currency">
            <field name="active">True</field>
        </record>

        <!-- Set company currency to KES and fiscal country to Kenya -->
        <record id="base.main_company" model="res.company">
            <field name="currency_id" ref="base.KES"/>
            <field name="account_fiscal_country_id" ref="base.ke"/>
        </record>

        <!-- Kenya VAT tax group -->
        <record id="tax_group_vat_ke" model="account.tax.group">
            <field name="name">VAT</field>
            <field name="country_id" ref="base.ke"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>

    <data noupdate="1">

    <!-- ================================================================
         FMS GL Accounts (noupdate=1 — created once, hand-editable after)
    ================================================================ -->

    <!-- 101600 — FMS Cash Clearing (asset_current)
         Debited on shift close for total meter cash sales.
         Cleared when cash is banked / reconciled with the bank statement.
         MUST be an asset account, NOT a revenue account. -->
    <!-- Use high codes unlikely to clash with any installed CoA -->
    <record id="account_fms_cash_clearing" model="account.account">
        <field name="code">191600</field>
        <field name="name">FMS Cash Clearing</field>
        <field name="account_type">asset_current</field>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="reconcile" eval="True"/>
    </record>

    <!-- 591000 — Fuel Cost of Sales (expense_direct_cost) -->
    <record id="account_fuel_cogs" model="account.account">
        <field name="code">591000</field>
        <field name="name">Fuel Cost of Sales</field>
        <field name="account_type">expense_direct_cost</field>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
    </record>

    <!-- Forecourt Sales Journal (type=sale) used for all shift GL entries -->
    <record id="journal_forecourt_sales" model="account.journal">
        <field name="name">Forecourt Sales</field>
        <field name="code">FCST</field>
        <field name="type">sale</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    </data>

    <!-- Site Preferences update — noupdate="0" so re-install patches existing record -->
    <data noupdate="0">
    <function model="fms.site.preferences" name="_fms_configure_defaults">
        <value eval="ref('account_fms_cash_clearing')"/>
        <value eval="ref('account_fuel_cogs')"/>
        <value eval="ref('journal_forecourt_sales')"/>
    </function>
    </data>

    <!-- Taxes use noupdate="0" so re-install updates them cleanly -->
    <data noupdate="0">

        <!-- VAT 16% — Sales -->
        <record id="tax_vat_16_sale" model="account.tax">
            <field name="name">VAT 16%</field>
            <field name="amount">16.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="price_include">False</field>
            <field name="country_id" ref="base.ke"/>
            <field name="tax_group_id" ref="tax_group_vat_ke"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- VAT 8% — Sales -->
        <record id="tax_vat_8_sale" model="account.tax">
            <field name="name">VAT 8%</field>
            <field name="amount">8.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="price_include">False</field>
            <field name="country_id" ref="base.ke"/>
            <field name="tax_group_id" ref="tax_group_vat_ke"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- VAT 16% — Purchase -->
        <record id="tax_vat_16_purchase" model="account.tax">
            <field name="name">VAT 16%</field>
            <field name="amount">16.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="price_include">False</field>
            <field name="country_id" ref="base.ke"/>
            <field name="tax_group_id" ref="tax_group_vat_ke"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- VAT 8% — Purchase -->
        <record id="tax_vat_8_purchase" model="account.tax">
            <field name="name">VAT 8%</field>
            <field name="amount">8.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="price_include">False</field>
            <field name="country_id" ref="base.ke"/>
            <field name="tax_group_id" ref="tax_group_vat_ke"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>
