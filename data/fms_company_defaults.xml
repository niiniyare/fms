<?xml version="1.0" encoding="utf-8"?>
<!--
    fms_company_defaults.xml — base-safe defaults only.
    Nothing here requires the `account` module.

    All GL accounts, journals, taxes, and company accounting fields
    (account_fiscal_country_id, currency_id) are set in
    fms_accounting/data/fms_accounting_company_defaults.xml,
    which loads only when fms_accounting (and therefore account) is installed.

    Currency: FMS does NOT force a company currency. The company's existing
    active currency is used. Activating base.KES here only makes KES
    selectable in the currency picker — it does not change the company currency.
-->
<odoo>
    <data noupdate="1">

        <!-- Make KES selectable — does not change company currency. -->
        <record id="base.KES" model="res.currency">
            <field name="active">True</field>
        </record>

    </data>
</odoo>
