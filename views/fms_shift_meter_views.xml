<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Standalone meter entry views
         (for direct access / Meter Movement list from the menu)
    ================================================================ -->

    <record id="view_fms_shift_meter_entry_tree" model="ir.ui.view">
        <field name="name">fms.shift.meter.entry.tree</field>
        <field name="model">fms.shift.meter.entry</field>
        <field name="arch" type="xml">
            <list string="Meter Entries">
                <field name="shift_id"/>
                <field name="pump_id"/>
                <field name="nozzle_id"/>
                <field name="product_id"/>
                <field name="attendant_id"/>
                <field name="closing_elec_cash" string="Elec Cash"/>
                <field name="closing_elec_volume" string="Elec Vol (L)"/>
                <field name="closing_man_mech" string="Manual (L)"/>
                <field name="rtt_volume" string="RTT (L)" optional="show"/>
                <field name="elec_cash_sold" string="Cash Sold" sum="Total Cash KES"/>
                <field name="qty_sold_elec" string="Vol Sold (L)" sum="Total L"/>
            </list>
        </field>
    </record>

    <record id="view_fms_shift_meter_entry_form" model="ir.ui.view">
        <field name="name">fms.shift.meter.entry.form</field>
        <field name="model">fms.shift.meter.entry</field>
        <field name="arch" type="xml">
            <form string="Meter Entry">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="shift_id"/>
                            <field name="pump_id"/>
                            <field name="nozzle_id"
                                   domain="[('pump_id','=',pump_id)]"/>
                            <field name="product_id" readonly="1"/>
                            <field name="attendant_id"
                                   domain="[('fms_is_attendant','=',True)]"/>
                        </group>
                        <group string="Elec Cash Meter">
                            <field name="opening_elec_cash" readonly="1"
                                   string="Opening"/>
                            <field name="closing_elec_cash"
                                   string="Closing"/>
                            <field name="elec_cash_sold" readonly="1"
                                   string="Cash Sold"/>
                        </group>
                        <group string="Elec Volume Meter (L)">
                            <field name="opening_elec_volume" readonly="1"
                                   string="Opening (L)"/>
                            <field name="closing_elec_volume"
                                   string="Closing (L)"/>
                            <field name="rtt_volume"
                                   string="RTT (L)"/>
                            <field name="qty_sold_elec" readonly="1"
                                   string="Vol Sold (L)"/>
                        </group>
                        <group string="Manual Meter (L)">
                            <field name="opening_man_mech" readonly="1"
                                   string="Opening (L)"/>
                            <field name="closing_man_mech"
                                   string="Closing (L)"/>
                            <field name="qty_sold_man" readonly="1"
                                   string="Man Sold (L)"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
