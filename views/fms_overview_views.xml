<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fms_overview_form" model="ir.ui.view">
        <field name="name">fms.overview.form</field>
        <field name="model">fms.overview</field>
        <field name="arch" type="xml">
            <form string="Forecourt Overview" create="false" edit="false" delete="false">

                <header>
                    <button string="Refresh" type="object" name="action_refresh"
                            class="btn-secondary"/>
                </header>

                <sheet>

                    <!-- ══════════════════════════════════════════════════
                         ALERT BANNER — mirrors account module's warning row
                    ══════════════════════════════════════════════════ -->

                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-0"
                         role="alert" invisible="not any_alert">
                        <i class="fa fa-exclamation-triangle fa-lg" title="Action required"/>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="action" name="%(action_fms_shift)d"
                                    string="Shift(s) open past close time"
                                    class="btn btn-danger btn-sm"
                                    invisible="shifts_open_late == 0"/>
                            <button type="action" name="%(action_fms_residual_exception)d"
                                    string="Unresolved residuals"
                                    class="btn btn-danger btn-sm"
                                    invisible="open_residuals == 0"/>
                            <button type="action" name="%(action_fms_incident_report)d"
                                    string="Open incident(s)"
                                    class="btn btn-warning btn-sm"
                                    invisible="unrecovered_incidents == 0"/>
                            <button type="action" name="%(action_fms_stock_position)d"
                                    string="Tank(s) at reorder"
                                    class="btn btn-warning btn-sm"
                                    invisible="reorder_tank_count == 0"/>
                        </div>
                    </div>

                    <div class="alert alert-success d-flex align-items-center gap-2 mb-0"
                         role="status" invisible="any_alert">
                        <i class="fa fa-check-circle fa-lg" title="All clear"/>
                        All clear — no action items.
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         STAT BUTTONS — same pattern as sale.order / stock.picking
                    ══════════════════════════════════════════════════ -->

                    <div class="o_button_box" name="button_box">

                        <!-- Today's shift -->
                        <button type="action" name="%(action_fms_shift)d"
                                class="o_stat_button" icon="fa-clock-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Current Shift</span>
                                <span class="o_stat_value">
                                    <field name="current_shift_label"/>
                                </span>
                            </div>
                        </button>

                        <!-- Yesterday throughput -->
                        <button type="action" name="%(action_fms_shift)d"
                                class="o_stat_button" icon="fa-tint">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Yesterday (L)</span>
                                <span class="o_stat_value">
                                    <field name="yesterday_throughput_l"
                                           options="{'digits': [16, 0]}"/>
                                </span>
                            </div>
                        </button>

                        <!-- Yesterday sales -->
                        <button type="action" name="%(action_fms_shift)d"
                                class="o_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Yesterday (KES)</span>
                                <span class="o_stat_value">
                                    <field name="yesterday_sales_kes"
                                           options="{'digits': [16, 0]}"/>
                                </span>
                            </div>
                        </button>

                        <!-- FC Cash balance -->
                        <button type="action" name="%(action_fms_shift)d"
                                class="o_stat_button o_stat_button_danger"
                                icon="fa-exclamation-circle"
                                title="Cash variance — click to view shifts"
                                invisible="yesterday_cash_var == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text text-danger">Cash Var.</span>
                                <span class="o_stat_value text-danger">
                                    <field name="yesterday_cash_var"/>
                                </span>
                            </div>
                        </button>

                        <button type="action" name="%(action_fms_shift)d"
                                class="o_stat_button"
                                icon="fa-check-circle-o"
                                title="Cash balanced"
                                invisible="yesterday_cash_var != 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text text-success">Cash</span>
                                <span class="o_stat_value text-success">Balanced ✓</span>
                            </div>
                        </button>

                        <!-- AR total (only if fms_accounting installed) -->
                        <button type="object" name="action_open_debtors"
                                class="o_stat_button" icon="fa-users"
                                groups="fms.group_fms_supervisor"
                                invisible="total_ar == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">AR Outstanding</span>
                                <span class="o_stat_value">
                                    <field name="total_ar" options="{'digits': [16, 0]}"/>
                                </span>
                            </div>
                        </button>

                        <!-- Attendants on duty -->
                        <button type="action" name="%(action_fms_shift)d"
                                class="o_stat_button" icon="fa-user">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Attendants</span>
                                <span class="o_stat_value">
                                    <field name="current_attendant_count"/>
                                </span>
                            </div>
                        </button>

                    </div>

                    <!-- ══════════════════════════════════════════════════
                         SECTION 1: Shifts (mirrors accounting's journal section)
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-4">Shifts</div>

                    <div class="row">
                        <!-- Left col: primary actions -->
                        <div class="col-12 col-sm-6 col-md-4 mb-3">
                            <button type="action" name="%(action_fms_shift)d"
                                    class="btn btn-primary me-1"
                                    groups="fms.group_fms_supervisor">
                                New Shift
                            </button>
                            <button type="action" name="%(action_fms_shift)d"
                                    class="btn btn-secondary">
                                All Shifts
                            </button>
                        </div>

                        <!-- Right col: quick-view links (like accounting's "3 To Validate / Unpaid") -->
                        <div class="col-12 col-sm-6 col-md-4 mb-3">
                            <div class="row" invisible="shifts_open_late == 0">
                                <div class="col overflow-hidden text-start">
                                    <button type="action" name="%(action_fms_shift)d"
                                            class="btn-link p-0 text-danger fw-bold">
                                        <field name="shifts_open_late"/> shift(s) overdue close
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col overflow-hidden text-start">
                                    <span class="text-muted">Supervisor</span>
                                </div>
                                <div class="col-auto text-end fw-bold">
                                    <field name="current_supervisor"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col overflow-hidden text-start">
                                    <span class="text-muted">Yesterday shifts</span>
                                </div>
                                <div class="col-auto text-end">
                                    <field name="yesterday_shifts"/>
                                </div>
                            </div>
                            <div class="row" invisible="open_shortage_kes == 0">
                                <div class="col overflow-hidden text-start">
                                    <button type="action" name="%(action_fms_shortage)d"
                                            class="btn-link p-0 text-warning"
                                            groups="fms.group_fms_supervisor">
                                        Outstanding shortages
                                    </button>
                                </div>
                                <div class="col-auto text-end text-warning fw-bold">
                                    <field name="open_shortage_kes" options="{'digits': [16, 0]}"/>
                                </div>
                            </div>
                        </div>

                        <!-- Graph col -->
                        <div class="col-12 col-md-4 mb-3">
                            <field name="throughput_graph" widget="dashboard_graph"
                                   graph_type="bar"/>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         SECTION 2: Wetstock / Tanks
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-2">Wetstock &amp; Tanks</div>

                    <div class="row">
                        <div class="col-12 col-sm-6 col-md-4 mb-3">
                            <button type="action" name="%(action_fms_stock_position)d"
                                    class="btn btn-secondary me-1">
                                Stock Position
                            </button>
                            <button type="action" name="%(action_fms_wetstock_report)d"
                                    class="btn btn-secondary">
                                Wetstock Report
                            </button>
                        </div>

                        <div class="col-12 col-sm-6 col-md-4 mb-3">
                            <div class="row" invisible="reorder_tank_count == 0">
                                <div class="col overflow-hidden text-start">
                                    <button type="action" name="%(action_fms_stock_position)d"
                                            class="btn-link p-0 text-warning fw-bold">
                                        <field name="reorder_tank_count"/> tank(s) at reorder point
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col overflow-hidden text-start">
                                    <span class="text-muted">Worst 7d variance</span>
                                </div>
                                <div class="col-auto text-end">
                                    <span class="badge bg-success"
                                          invisible="worst_variance_verdict != 'ok'">
                                        <field name="worst_tank_name"/>
                                        <field name="worst_variance_pct"/>%
                                    </span>
                                    <span class="badge bg-warning text-dark"
                                          invisible="worst_variance_verdict != 'warn'">
                                        <field name="worst_tank_name"/>
                                        <field name="worst_variance_pct"/>%
                                    </span>
                                    <span class="badge bg-danger"
                                          invisible="worst_variance_verdict != 'breach'">
                                        <field name="worst_tank_name"/>
                                        <field name="worst_variance_pct"/>% BREACH
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         SECTION 3: Debtors / AR
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-2"
                         invisible="total_ar == 0 and over_limit_count == 0">
                        Debtors
                    </div>

                    <div class="row" invisible="total_ar == 0 and over_limit_count == 0">
                        <div class="col-12 col-sm-6 col-md-4 mb-3">
                            <button type="object" name="action_open_debtors"
                                    class="btn btn-secondary"
                                    groups="fms.group_fms_supervisor">
                                Debtors Aging
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 mb-3">
                            <div class="row">
                                <div class="col overflow-hidden text-start">
                                    <span class="text-muted">Total outstanding</span>
                                </div>
                                <div class="col-auto text-end fw-bold">
                                    <field name="total_ar" options="{'digits': [16, 0]}"/>
                                </div>
                            </div>
                            <div class="row" invisible="over_limit_count == 0">
                                <div class="col overflow-hidden text-start">
                                    <button type="object" name="action_open_debtors"
                                            class="btn-link p-0 text-danger"
                                            groups="fms.group_fms_supervisor">
                                        <field name="over_limit_count"/> over credit limit
                                    </button>
                                </div>
                            </div>
                            <div class="row" invisible="ar_overdue_90 == 0">
                                <div class="col overflow-hidden text-start">
                                    <span class="text-muted text-warning">90+ days overdue</span>
                                </div>
                                <div class="col-auto text-end text-warning">
                                    <field name="ar_overdue_90" options="{'digits': [16, 0]}"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         SECTION 4: Reports quick-links (like accounting's "Reporting" column)
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-2">Reporting</div>

                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <button type="action" name="%(action_fms_attendant_sales_report)d"
                                class="btn btn-sm btn-outline-secondary">
                            Attendant Sales
                        </button>
                        <button type="action" name="%(action_fms_wetstock_report)d"
                                class="btn btn-sm btn-outline-secondary">
                            30-Day Wetstock Variance
                        </button>
                        <button type="action" name="%(action_fms_residual_exception)d"
                                class="btn btn-sm btn-outline-secondary">
                            Residual Exceptions
                        </button>
                        <button type="action" name="%(action_fms_incident_report)d"
                                class="btn btn-sm btn-outline-secondary">
                            Incidents
                        </button>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action: creates fresh record and opens it -->
    <record id="action_fms_overview_server" model="ir.actions.server">
        <field name="name">Open Forecourt Overview</field>
        <field name="model_id" ref="model_fms_overview"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_overview()</field>
    </record>

</odoo>
