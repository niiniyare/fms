<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Overview Dashboard — §15 spec
         Form view on fms.overview (TransientModel).
         Opened via action_open_overview which creates a fresh computed record.
    ================================================================ -->

    <record id="view_fms_overview_form" model="ir.ui.view">
        <field name="name">fms.overview.form</field>
        <field name="model">fms.overview</field>
        <field name="arch" type="xml">
            <form string="Forecourt Overview" create="false" edit="false" delete="false">

                <!-- ─── Toolbar ──────────────────────────────────────────── -->
                <header>
                    <button string="Refresh"
                            type="action"
                            name="action_open_overview"
                            class="btn-secondary"/>
                </header>

                <sheet>

                    <!-- ══════════════════════════════════════════════════
                         ROW 1 — Action Required  (hidden when empty)
                    ══════════════════════════════════════════════════ -->

                    <div class="alert alert-danger mb-3"
                         invisible="not any_alert">
                        <strong>Action Required</strong>
                        <div class="d-flex flex-wrap gap-3 mt-2">

                            <a type="action" name="%(action_fms_shift)d"
                               class="btn btn-danger btn-sm"
                               invisible="shifts_open_late == 0">
                                <i class="fa fa-clock-o"/> <field name="shifts_open_late"/> Shift(s) open past close time
                            </a>

                            <a type="action" name="%(action_fms_residual_exception)d"
                               class="btn btn-danger btn-sm"
                               invisible="open_residuals == 0">
                                <i class="fa fa-exclamation-triangle"/> <field name="open_residuals"/> Open Residual(s)
                            </a>

                            <a type="action" name="%(action_fms_incident_report)d"
                               class="btn btn-warning btn-sm"
                               invisible="unrecovered_incidents == 0">
                                <i class="fa fa-car"/> <field name="unrecovered_incidents"/> Unrecovered Incident(s)
                            </a>

                            <a type="action" name="%(action_fms_stock_position)d"
                               class="btn btn-warning btn-sm"
                               invisible="reorder_tank_count == 0">
                                <i class="fa fa-tint"/> <field name="reorder_tank_count"/> Tank(s) at Reorder Point
                            </a>

                        </div>
                    </div>

                    <!-- No alerts state -->
                    <div class="alert alert-success mb-3" invisible="any_alert">
                        <i class="fa fa-check-circle"/> All clear — no action items at this time.
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 2 — Yesterday
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-4 mb-2">
                        <span>Yesterday — <field name="yesterday_date" readonly="1" nolabel="1"/></span>
                    </div>

                    <div class="row mb-3">

                        <!-- Throughput -->
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Throughput</div>
                                    <div class="fs-4 fw-bold">
                                        <field name="yesterday_throughput_l" widget="float" options="{'digits': [16,0]}"/> L
                                    </div>
                                    <div>
                                        <span invisible="yesterday_throughput_vs == 0">
                                            <span class="badge"
                                                  invisible="yesterday_throughput_vs &gt; -15 and yesterday_throughput_vs &lt; 15">
                                                <field name="yesterday_throughput_vs"/>% vs 7d avg
                                            </span>
                                            <span class="text-success"
                                                  invisible="yesterday_throughput_vs &lt; 15">
                                                ▲ <field name="yesterday_throughput_vs"/>% vs 7d avg
                                            </span>
                                            <span class="text-danger"
                                                  invisible="yesterday_throughput_vs &gt; -15">
                                                ▼ <field name="yesterday_throughput_vs"/>% vs 7d avg
                                            </span>
                                        </span>
                                    </div>
                                    <div class="text-muted small mt-1"><field name="yesterday_shifts"/> shift(s)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Sales Value -->
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Sales Value</div>
                                    <div class="fs-4 fw-bold">
                                        KES <field name="yesterday_sales_kes" widget="float" options="{'digits': [16,0]}"/>
                                    </div>
                                    <div class="text-muted small mt-1">Meter-based · all shifts</div>
                                </div>
                            </div>
                        </div>

                        <!-- Cash Over/Short -->
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted small">FC Cash Balance</div>
                                    <div class="fs-4 fw-bold"
                                         style="color: green;" invisible="yesterday_cash_var != 0">
                                        KES <field name="yesterday_cash_var" widget="float"/> ✓
                                    </div>
                                    <div class="fs-4 fw-bold text-danger"
                                         invisible="yesterday_cash_var == 0">
                                        KES <field name="yesterday_cash_var" widget="float"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <span invisible="yesterday_cash_var == 0">Non-zero — supervisor action needed</span>
                                        <span invisible="yesterday_cash_var != 0">Balanced</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Worst Wetstock Variance -->
                        <div class="col-12 col-md-3 mb-2">
                            <a type="action" name="%(action_fms_wetstock_report)d" class="text-decoration-none">
                                <div class="card h-100 hover-shadow"
                                     style="border-color: #198754;" invisible="worst_variance_verdict == 'ok'  or worst_variance_verdict == False">
                                </div>
                                <div class="card h-100">
                                    <div class="card-body text-center">
                                        <div class="text-muted small">Worst Wetstock (7d)</div>
                                        <div class="fs-4 fw-bold">
                                            <field name="worst_tank_name"/>
                                        </div>
                                        <div>
                                            <span class="badge bg-success"
                                                  invisible="worst_variance_verdict != 'ok'">
                                                <field name="worst_variance_pct"/>% — Within tolerance
                                            </span>
                                            <span class="badge bg-warning text-dark"
                                                  invisible="worst_variance_verdict != 'warn'">
                                                <field name="worst_variance_pct"/>% — Approaching limit
                                            </span>
                                            <span class="badge bg-danger"
                                                  invisible="worst_variance_verdict != 'breach'">
                                                <field name="worst_variance_pct"/>% — BREACH
                                            </span>
                                        </div>
                                        <div class="text-muted small mt-1">→ Wetstock Reconciliation</div>
                                    </div>
                                </div>
                            </a>
                        </div>

                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 3 — Stock & Days of Cover
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-3 mb-2">
                        <span>Stock &amp; Days of Cover</span>
                        <button string="Open Stock Report →"
                                type="action"
                                name="%(action_fms_stock_position)d"
                                class="btn btn-sm btn-outline-secondary ms-2"/>
                    </div>

                    <field name="reorder_tank_count" invisible="1"/>
                    <div class="alert alert-warning mb-2" invisible="reorder_tank_count == 0">
                        <i class="fa fa-exclamation-triangle"/>
                        <strong> <field name="reorder_tank_count"/> tank(s) at or below reorder point.</strong>
                        Place orders now.
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 4 — Cumulative Variance Chart (link only)
                    ══════════════════════════════════════════════════ -->

                    <div class="mt-2 mb-3">
                        <button string="📈  30-Day Cumulative Wetstock Variance →"
                                type="action"
                                name="%(action_fms_wetstock_report)d"
                                class="btn btn-outline-primary"/>
                        <span class="text-muted small ms-2">
                            The single chart that detects a developing leak before any other signal.
                        </span>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 5 — Debtors
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-3 mb-2">
                        <span>Money Owed (AR)</span>
                    </div>

                    <div class="row mb-3" invisible="total_ar == 0 and over_limit_count == 0">
                        <div class="col-12 col-md-4 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Total Outstanding</div>
                                    <div class="fs-5 fw-bold">KES <field name="total_ar" widget="float" options="{'digits': [16,0]}"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4 mb-2">
                            <div class="card" style="border-color: #dc3545;" invisible="over_limit_count == 0">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Over Credit Limit</div>
                                    <div class="fs-5 fw-bold text-danger">
                                        <field name="over_limit_count"/> customer(s)
                                    </div>
                                </div>
                            </div>
                            <div class="card" invisible="over_limit_count != 0">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Over Credit Limit</div>
                                    <div class="fs-5 fw-bold text-success">None</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4 mb-2">
                            <div class="card" style="border-color: #fd7e14;" invisible="ar_overdue_90 == 0">
                                <div class="card-body text-center">
                                    <div class="text-muted small">90+ Days Overdue</div>
                                    <div class="fs-5 fw-bold text-warning">
                                        KES <field name="ar_overdue_90" widget="float" options="{'digits': [16,0]}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2" invisible="total_ar == 0 and over_limit_count == 0">
                        <button string="Debtors Aging &amp; Credit Exposure →"
                                type="action"
                                name="%(fms_accounting.action_fms_debtor_aging)d"
                                class="btn btn-sm btn-outline-secondary"/>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 6 — Current Shift / People
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-3 mb-2">
                        <span>Current Shift</span>
                    </div>

                    <div class="row mb-2">
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Shift</div>
                                    <div class="fw-bold"><field name="current_shift_label"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Supervisor</div>
                                    <div class="fw-bold"><field name="current_supervisor"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Attendants on Duty</div>
                                    <div class="fw-bold"><field name="current_attendant_count"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card" style="border-color: #dc3545;"
                                 invisible="open_shortage_kes == 0">
                                <div class="card-body">
                                    <div class="text-muted small">Outstanding Shortages</div>
                                    <div class="fw-bold text-danger">
                                        KES <field name="open_shortage_kes" widget="float" options="{'digits': [16,0]}"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card" invisible="open_shortage_kes != 0">
                                <div class="card-body">
                                    <div class="text-muted small">Outstanding Shortages</div>
                                    <div class="fw-bold text-success">None</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button string="Open Shifts →"
                                type="action"
                                name="%(action_fms_shift)d"
                                class="btn btn-sm btn-outline-secondary"/>
                        <button string="Shortage &amp; Overage Ledger →"
                                type="action"
                                name="%(action_fms_shortage)d"
                                class="btn btn-sm btn-outline-secondary ms-2"
                                groups="fms.group_fms_supervisor"/>
                        <button string="Attendant Sales &amp; Cash →"
                                type="action"
                                name="%(action_fms_attendant_sales_report)d"
                                class="btn btn-sm btn-outline-secondary ms-2"/>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Client action — entry point from the Overview menu item
         Calls _compute_overview and redirects to the freshly-created record
    ================================================================ -->

    <record id="action_fms_overview_dashboard" model="ir.actions.server">
        <field name="name">Forecourt Overview</field>
        <field name="model_id" ref="model_fms_overview"/>
        <field name="binding_model_id" ref="model_fms_overview"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_overview()</field>
    </record>

</odoo>
