<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fms_overview_form" model="ir.ui.view">
        <field name="name">fms.overview.form</field>
        <field name="model">fms.overview</field>
        <field name="arch" type="xml">
            <form string="Forecourt Overview" create="false" edit="false" delete="false">

                <header>
                    <button string="Refresh" type="object" name="action_refresh"
                            class="btn-secondary"/>
                </header>

                <sheet>

                    <!-- ══════════════════════════════════════════════════
                         ROW 1 — Action Required
                    ══════════════════════════════════════════════════ -->

                    <!-- Alert banner — shown when at least one tile fires -->
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="not any_alert">
                        <strong>Action Required</strong>
                        <div class="d-flex flex-wrap gap-2 mt-2">

                            <button type="action"
                                    name="%(action_fms_shift)d"
                                    string="Shift(s) open past close time"
                                    class="btn btn-danger btn-sm"
                                    invisible="shifts_open_late == 0"/>

                            <button type="action"
                                    name="%(action_fms_residual_exception)d"
                                    string="Open Residual(s)"
                                    class="btn btn-danger btn-sm"
                                    invisible="open_residuals == 0"/>

                            <button type="action"
                                    name="%(action_fms_incident_report)d"
                                    string="Unrecovered Incident(s)"
                                    class="btn btn-warning btn-sm"
                                    invisible="unrecovered_incidents == 0"/>

                            <button type="action"
                                    name="%(action_fms_stock_position)d"
                                    string="Tank(s) at Reorder Point"
                                    class="btn btn-warning btn-sm"
                                    invisible="reorder_tank_count == 0"/>

                        </div>
                    </div>

                    <!-- All-clear banner -->
                    <div class="alert alert-success mb-3" role="status"
                         invisible="any_alert">
                        All clear — no action items at this time.
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 2 — Yesterday
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-4 mb-2">
                        Yesterday —
                        <field name="yesterday_date" readonly="1" nolabel="1"/>
                    </div>

                    <div class="row mb-3">

                        <!-- Throughput -->
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Throughput</div>
                                    <div class="fs-4 fw-bold">
                                        <field name="yesterday_throughput_l"
                                               options="{'digits': [16,0]}"/> L
                                    </div>
                                    <div class="text-success"
                                         invisible="yesterday_throughput_vs &lt; 15">
                                        ▲ <field name="yesterday_throughput_vs"/>% vs 7d avg
                                    </div>
                                    <div class="text-danger"
                                         invisible="yesterday_throughput_vs &gt; -15">
                                        ▼ <field name="yesterday_throughput_vs"/>% vs 7d avg
                                    </div>
                                    <div class="text-muted"
                                         invisible="yesterday_throughput_vs &gt; -15 or yesterday_throughput_vs &lt; 15">
                                        <field name="yesterday_throughput_vs"/>% vs 7d avg
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <field name="yesterday_shifts"/> shift(s)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sales Value -->
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Sales Value</div>
                                    <div class="fs-4 fw-bold">
                                        KES <field name="yesterday_sales_kes"
                                                   options="{'digits': [16,0]}"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        Meter-based · all shifts
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- FC Cash Balance -->
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted small">FC Cash Balance</div>
                                    <div class="fs-4 fw-bold text-success"
                                         invisible="yesterday_cash_var != 0">
                                        KES 0 ✓
                                    </div>
                                    <div class="fs-4 fw-bold text-danger"
                                         invisible="yesterday_cash_var == 0">
                                        KES <field name="yesterday_cash_var"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <span invisible="yesterday_cash_var == 0">
                                            Supervisor action needed
                                        </span>
                                        <span invisible="yesterday_cash_var != 0">
                                            Balanced
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Worst Wetstock Variance -->
                        <div class="col-12 col-md-3 mb-2">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Worst Wetstock (7d)</div>
                                    <div class="fs-5 fw-bold">
                                        <field name="worst_tank_name"/>
                                    </div>
                                    <div class="badge bg-success"
                                         invisible="worst_variance_verdict != 'ok'">
                                        <field name="worst_variance_pct"/>% — Within tolerance
                                    </div>
                                    <div class="badge bg-warning text-dark"
                                         invisible="worst_variance_verdict != 'warn'">
                                        <field name="worst_variance_pct"/>% — Approaching limit
                                    </div>
                                    <div class="badge bg-danger"
                                         invisible="worst_variance_verdict != 'breach'">
                                        <field name="worst_variance_pct"/>% — BREACH
                                    </div>
                                    <div class="mt-2">
                                        <button type="action"
                                                name="%(action_fms_wetstock_report)d"
                                                string="Wetstock Report →"
                                                class="btn btn-sm btn-outline-secondary"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 3 — Stock & Days of Cover
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-3 mb-2">
                        Stock &amp; Days of Cover
                    </div>

                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="reorder_tank_count == 0">
                        <strong>
                            <field name="reorder_tank_count"/> tank(s) at or below reorder point.
                        </strong>
                        Place orders now.
                    </div>

                    <div class="mb-3">
                        <button type="action"
                                name="%(action_fms_stock_position)d"
                                string="Stock Position &amp; Days of Cover →"
                                class="btn btn-outline-primary btn-sm"/>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 4 — 30-Day Cumulative Variance Chart (link)
                    ══════════════════════════════════════════════════ -->

                    <div class="mb-3">
                        <button type="action"
                                name="%(action_fms_wetstock_report)d"
                                string="30-Day Cumulative Wetstock Variance →"
                                class="btn btn-outline-primary"/>
                        <span class="text-muted small ms-2">
                            The chart that detects a developing leak before any other signal.
                        </span>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 5 — Debtors
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-3 mb-2">
                        Money Owed (AR)
                    </div>

                    <div class="row mb-2" invisible="total_ar == 0 and over_limit_count == 0">

                        <div class="col-12 col-md-4 mb-2">
                            <div class="card">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Total Outstanding</div>
                                    <div class="fs-5 fw-bold">
                                        KES <field name="total_ar"
                                                   options="{'digits': [16,0]}"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4 mb-2">
                            <div class="card border-danger" invisible="over_limit_count == 0">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Over Credit Limit</div>
                                    <div class="fs-5 fw-bold text-danger">
                                        <field name="over_limit_count"/> customer(s)
                                    </div>
                                </div>
                            </div>
                            <div class="card" invisible="over_limit_count != 0">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Over Credit Limit</div>
                                    <div class="fs-5 fw-bold text-success">None</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4 mb-2"
                             invisible="ar_overdue_90 == 0">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <div class="text-muted small">90+ Days Overdue</div>
                                    <div class="fs-5 fw-bold text-warning">
                                        KES <field name="ar_overdue_90"
                                                   options="{'digits': [16,0]}"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="mb-3" invisible="total_ar == 0 and over_limit_count == 0">
                        <button type="object"
                                name="action_open_debtors"
                                string="Debtors Aging &amp; Credit Exposure →"
                                class="btn btn-sm btn-outline-secondary"
                                groups="fms.group_fms_supervisor"/>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         ROW 6 — Current Shift / People
                    ══════════════════════════════════════════════════ -->

                    <div class="o_horizontal_separator mt-3 mb-2">
                        Current Shift
                    </div>

                    <div class="row mb-3">

                        <div class="col-12 col-md-3 mb-2">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Period</div>
                                    <div class="fw-bold">
                                        <field name="current_shift_label"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-3 mb-2">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Supervisor</div>
                                    <div class="fw-bold">
                                        <field name="current_supervisor"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-3 mb-2">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Attendants on Duty</div>
                                    <div class="fw-bold">
                                        <field name="current_attendant_count"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-3 mb-2">
                            <div class="card border-danger"
                                 invisible="open_shortage_kes == 0">
                                <div class="card-body">
                                    <div class="text-muted small">Outstanding Shortages</div>
                                    <div class="fw-bold text-danger">
                                        KES <field name="open_shortage_kes"
                                                   options="{'digits': [16,0]}"/>
                                    </div>
                                </div>
                            </div>
                            <div class="card" invisible="open_shortage_kes != 0">
                                <div class="card-body">
                                    <div class="text-muted small">Outstanding Shortages</div>
                                    <div class="fw-bold text-success">None</div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="action"
                                name="%(action_fms_shift)d"
                                string="Open Shifts →"
                                class="btn btn-sm btn-outline-secondary"/>
                        <button type="action"
                                name="%(action_fms_shortage)d"
                                string="Shortage &amp; Overage Ledger →"
                                class="btn btn-sm btn-outline-secondary"
                                groups="fms.group_fms_supervisor"/>
                        <button type="action"
                                name="%(action_fms_attendant_sales_report)d"
                                string="Attendant Sales &amp; Cash →"
                                class="btn btn-sm btn-outline-secondary"/>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Window action — opens a new fms.overview record.
         default_get() auto-computes all tile values on create.
    ================================================================ -->

    <record id="action_fms_overview_dashboard" model="ir.actions.act_window">
        <field name="name">Forecourt Overview</field>
        <field name="res_model">fms.overview</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fms_overview_form"/>
        <field name="target">main</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
