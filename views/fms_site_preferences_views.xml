<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fms_site_preferences_form" model="ir.ui.view">
        <field name="name">fms.site.preferences.form</field>
        <field name="model">fms.site.preferences</field>
        <field name="arch" type="xml">
            <form string="Site Preferences" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>FMS Site Preferences</h1>
                        <h4>
                            <field name="company_id" readonly="1"/>
                        </h4>
                    </div>

                    <group string="Gate — Tank Dip Variance">
                        <field name="default_dip_variance_meniscus"
                               string="Dip Variance Meniscus (L)"
                               widget="float"
                               help="Shift close is blocked if any tank's shift variance exceeds this absolute limit in litres. Default: ±1000 L."/>
                        <field name="meniscus_pct"
                               string="Meter vs Invoice Tolerance (%)"
                               widget="float"
                               help="Used by Gate 6 (meter volume vs invoice volume check). Separate from the dip gate."/>
                    </group>

                    <group string="Gate — Three-Meter Reconciliation">
                        <field name="elec_vs_cash_threshold_l"
                               string="Elec vs Cash Threshold (L)"
                               help="Maximum allowed variance between Electronic volume and Cash meter implied volume per nozzle. Set to 0 to disable."/>
                    </group>

                    <group string="Shift Concurrency">
                        <field name="allow_multiple_disputed"
                               string="Allow Multiple Disputed Shifts"
                               widget="boolean_toggle"/>
                    </group>

                    <group string="Attendant Assignment">
                        <field name="attendant_assignment_mode" widget="radio"/>
                    </group>

                    <group string="Shift Labels">
                        <group>
                            <field name="shift_label_1" string="Shift 1"/>
                            <field name="shift_label_2" string="Shift 2"/>
                            <field name="shift_label_3" string="Shift 3"/>
                        </group>
                    </group>

                    <group string="GL Accounts">
                        <group string="Defaults for New Products">
                            <field name="default_revenue_account_id"/>
                            <field name="default_cogs_account_id"/>
                        </group>
                        <group string="Shift Posting">
                            <field name="clearing_account_id"
                                   help="Debited on shift close for cash meter sales total."/>
                            <field name="sales_journal_id"/>
                        </group>
                    </group>

                    <group string="Shift Schedule">
                        <field name="shift_duration_hrs" widget="radio"/>
                        <field name="shift_1_start_hour" string="Shift 1 Start (hour)"
                               invisible="shift_duration_hrs == '24'"/>
                        <field name="shift_2_start_hour" string="Shift 2 Start (hour)"
                               invisible="shift_duration_hrs in ('24', '12')"/>
                        <field name="shift_3_start_hour" string="Shift 3 Start (hour)"
                               invisible="shift_duration_hrs == '24'"/>
                    </group>

                    <group string="Operational">
                        <field name="auto_sync_attendants"/>
                        <field name="auto_open_next_shift"/>
                        <field name="require_pos_reconciliation"/>
                    </group>

                    <group string="Variance Resolution">
                        <field name="staff_advance_account_id"/>
                        <field name="allow_variance_writeoff"/>
                        <field name="variance_writeoff_account_id"
                               invisible="not allow_variance_writeoff"/>
                        <field name="max_writeoff_amount"
                               invisible="not allow_variance_writeoff"
                               string="Write-Off Threshold (±)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fms_site_preferences" model="ir.actions.act_window">
        <field name="name">Site Preferences</field>
        <field name="res_model">fms.site.preferences</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

    <!-- Server action used by the menu: resolves existing record to avoid UNIQUE constraint -->
    <record id="action_fms_site_preferences_open" model="ir.actions.server">
        <field name="name">Open Site Preferences</field>
        <field name="model_id" ref="model_fms_site_preferences"/>
        <field name="state">code</field>
        <field name="code">
prefs = env['fms.site.preferences'].get_for_company(env.company)
action = {
    'type': 'ir.actions.act_window',
    'name': 'Site Preferences',
    'res_model': 'fms.site.preferences',
    'view_mode': 'form',
    'res_id': prefs.id,
    'target': 'main',
    'context': {'form_view_initial_mode': 'edit'},
}
        </field>
    </record>

    <!-- menu moved to views/fms_menus.xml -->

</odoo>
