<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Main unified shift form — spec Section 3.3 / Section 10.2
         Layout: Header → Meter Readings → Tank Dips →
                 Attendant Cash → Sales Summary → Residual Allocations
    ================================================================ -->

    <record id="view_fms_shift_form" model="ir.ui.view">
        <field name="name">fms.shift.form</field>
        <field name="model">fms.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">

                <!-- ── Header bar ── -->
                <header>
                    <button name="action_open_shift" string="Open Shift"
                            type="object" class="btn-primary"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'draft'"/>
                    <button name="action_start_closing" string="Start Closing"
                            type="object" class="btn-warning"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'open'"/>
                    <button name="action_close_shift" string="Close Shift"
                            type="object" class="btn-danger"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'closing'"
                            confirm="This will lock the shift and post all journal entries. Continue?"/>
                    <button name="action_sync_attendant_cash_lines"
                            string="Sync Attendants"
                            type="object" class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state not in ('open', 'closing')"
                            title="Add cash lines for any attendant assigned to a nozzle but not yet in the Attendant Cash tab"/>
                    <button name="action_refresh_product_sales"
                            string="Refresh Sales"
                            type="object" class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state not in ('open', 'closing')"/>
                    <button name="action_calculate_residuals"
                            string="Recalculate Residuals"
                            type="object" class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state not in ('open', 'closing')"
                            confirm="This will clear and rebuild all residual allocations. Continue?"/>
                    <button name="action_report_fms_shift"
                            string="Print Shift Report"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <button name="action_report_meter_movement"
                            string="Print Meter Movement"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closing,closed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="date"/> —
                            <field name="label"/>
                        </h1>
                    </div>

                    <!-- ── Shift Identity ── -->
                    <group>
                        <group string="Shift Details">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="label" readonly="state != 'draft'"/>
                            <field name="supervisor_id"
                                   placeholder="Assign any time before closing"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Timestamps">
                            <field name="planned_open"  readonly="1"
                                   invisible="not planned_open"/>
                            <field name="planned_close" readonly="1"
                                   invisible="not planned_close"/>
                            <field name="opening_meter_date" readonly="1"/>
                            <field name="opening_meter_user_id" readonly="1"/>
                            <field name="closing_meter_date" readonly="1"/>
                            <field name="closing_meter_user_id" readonly="1"/>
                            <field name="sales_journal_entry_id" readonly="1"
                                   invisible="not sales_journal_entry_id"
                                   string="Sales GL Entry"/>
                        </group>
                    </group>

                    <!-- ── Reconciliation Summary (read-only, visible in closing/closed) ── -->
                    <group string="Reconciliation Summary"
                           invisible="state not in ('closing', 'closed')"
                           class="o_group_col_4">
                        <group string="Meter vs Cash">
                            <field name="total_meter_sales" readonly="1"
                                   string="Meter Sales (KES)"
                                   widget="monetary"/>
                            <field name="total_reported_sales" readonly="1"
                                   string="Attendant-Reported Sales"
                                   widget="monetary"/>
                        </group>
                        <group string="FC Cash Balance">
                            <field name="fc_cash_balance" readonly="1"
                                   string="FC Cash Balance"
                                   widget="monetary"
                                   decoration-danger="fc_cash_balance != 0"
                                   decoration-success="fc_cash_balance == 0"/>

                        </group>
                    </group>

                    <notebook>

                        <!-- ═══════════════════════════════════════════
                             TAB 1: Pump Meter Readings
                        ═══════════════════════════════════════════ -->
                        <page string="Meter Readings" name="meters">
                            <field name="meter_entry_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Pump Meter Readings">
                                    <field name="pump_id"/>
                                    <field name="nozzle_id"
                                           domain="[('pump_id','=',pump_id)]"/>
                                    <field name="product_id" column_invisible="1"/>
                                    <field name="attendant_id"
                                           string="Attendant"
                                           domain="[('fms_is_attendant','=',True)]"/>

                                    <!-- Opening (read-only, auto-fetched) -->
                                    <field name="opening_elec_cash"
                                           string="Open Cash" readonly="1"
                                           optional="hide"/>
                                    <field name="opening_elec_volume"
                                           string="Open Elec (L)" readonly="1"
                                           optional="hide"/>

                                    <!-- Closing (editable) -->
                                    <field name="closing_elec_cash"
                                           string="Close Cash"/>
                                    <field name="closing_elec_volume"
                                           string="Close Elec (L)"/>
                                    <field name="closing_man_mech"
                                           string="Close Manual (L)" optional="show"/>

                                    <!-- RTT -->
                                    <field name="rtt_volume"
                                           string="RTT (L)" optional="show"/>

                                    <!-- Computed net -->
                                    <field name="elec_cash_sold" readonly="1"
                                           string="Cash Sold" sum="Total Cash (KES)"/>
                                    <field name="qty_sold_elec" readonly="1"
                                           string="Vol Sold (L)" sum="Total Litres"
                                           optional="show"/>
                                    <field name="amount_elec" readonly="1"
                                           string="Vol × Price" optional="hide"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <group>
                                <group string="Totals">
                                    <field name="total_meter_sales" readonly="1"
                                           string="Total Meter Sales (KES)"
                                           widget="monetary"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 2: Tank Dips
                        ═══════════════════════════════════════════ -->
                        <page string="Tank Dips" name="dips">
                            <field name="dip_entry_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Tank Dip Readings">
                                    <field name="location_id" string="Tank"
                                           readonly="1"/>
                                    <field name="product_id" readonly="1"
                                           string="Product"/>
                                    <field name="opening_volume" readonly="1"
                                           string="Opening (L)" optional="show"/>
                                    <field name="book_stock_open" readonly="1"
                                           string="Book Stock (L)" optional="show"/>
                                    <field name="closing_volume"
                                           string="Closing Dip (L)"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 3: Attendant Cash
                             Each person: what they should have vs what they declared
                        ═══════════════════════════════════════════ -->
                        <page string="Attendant Cash" name="attendants">
                            <field name="attendant_cash_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Attendant Cash Reconciliation"
                                      decoration-danger="balance != 0"
                                      decoration-success="balance == 0">
                                    <field name="attendant_id" string="Attendant"/>

                                    <!-- IN: what they should account for -->
                                    <field name="reported_sales" readonly="1"
                                           string="Pump Sales (KES)"
                                           sum="Pump Sales"/>
                                    <field name="float_amount"
                                           string="Float Given" optional="show"/>
                                    <field name="customer_receipt_amount"
                                           string="Receipts In" optional="show"/>
                                    <field name="direct_sales_cash"
                                           string="Cash Direct Sales" optional="hide"/>
                                    <field name="cash_drop_amount"
                                           string="Cash Drop (−)" optional="show"/>
                                    <field name="total_in" readonly="1"
                                           string="Total Accountable"
                                           sum="Total In"/>

                                    <!-- OUT: how they settled -->
                                    <field name="cash_collected"
                                           string="Cash Handover"/>
                                    <field name="mpesa_amount"
                                           string="MPesa" optional="show"/>
                                    <field name="card_amount"
                                           string="Card" optional="show"/>
                                    <field name="ar_amount"
                                           string="AR / Credit" optional="show"/>
                                    <field name="expense_amount"
                                           string="Expenses" readonly="1"
                                           optional="show"/>
                                    <field name="vendor_payment_amount"
                                           string="Vendor Pmts" readonly="1"
                                           optional="hide"/>
                                    <field name="total_out" readonly="1"
                                           string="Total Declared"
                                           sum="Total Out"/>

                                    <!-- Balance (must = 0) -->
                                    <field name="balance" readonly="1"
                                           string="Balance"
                                           sum="FC Cash Balance"
                                           decoration-danger="balance != 0"
                                           decoration-success="balance == 0"/>
                                </list>
                            </field>

                            <group>
                                <group string="Totals">
                                    <field name="fc_cash_balance" readonly="1"
                                           string="FC Cash Balance (must = 0)"
                                           widget="monetary"
                                           decoration-danger="fc_cash_balance != 0"
                                           decoration-success="fc_cash_balance == 0"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 4: Sales Summary (read-only)
                             Per-product meter vs POS reconciliation
                        ═══════════════════════════════════════════ -->
                        <page string="Sales Summary" name="sales_summary">
                            <field name="product_sales_ids" readonly="1"
                                   context="{'default_shift_id': id}">
                                <list string="Product Sales Summary"
                                      create="false" delete="false" edit="false">
                                    <field name="product_id" string="Product"/>
                                    <field name="elec_cash_sold" string="Cash Meter (KES)"
                                           sum="Cash Meter"/>
                                    <field name="meter_volume" string="Meter Vol (L)"
                                           sum="Meter Volume"/>
                                    <field name="meter_volume_man" string="Manual (L)"
                                           optional="hide" sum="Manual"/>
                                    <field name="price_at_close" string="Price /L"
                                           optional="hide"/>
                                    <field name="meter_revenue" string="Meter Revenue"
                                           optional="show" sum="Meter Revenue"/>
                                    <field name="accounted_volume" string="POS Vol (L)"
                                           optional="show" sum="POS Volume"/>
                                    <field name="volume_residual" string="Residual (L)"
                                           optional="show" sum="Residual"
                                           decoration-danger="volume_residual != 0"
                                           decoration-success="volume_residual == 0"/>
                                    <field name="allocated_volume" string="Allocated (L)"
                                           optional="show" sum="Allocated"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2"
                               invisible="state in ('open',)">
                                Sales summary is computed on shift open and refreshed via
                                <strong>Refresh Sales</strong>. Volume Residual = meter litres
                                not matched by POS; these are auto-allocated on shift close.
                            </p>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 5: Residual Allocations (read-only)
                             Auto-calculated cross-product reallocation
                        ═══════════════════════════════════════════ -->
                        <page string="Residual Allocations" name="residuals">
                            <field name="residual_allocation_ids" readonly="1"
                                   invisible="not residual_allocation_ids">
                                <list string="Residual Allocations"
                                      create="false" delete="false" edit="false">
                                    <field name="source_product_id" string="From Product"/>
                                    <field name="target_product_id" string="To Product"/>
                                    <field name="qty_litres" string="Qty (L)" sum="Total L"/>
                                    <field name="amount" string="Amount (KES)" sum="Total KES"/>
                                    <field name="journal_entry_id" string="GL Entry"
                                           optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted"
                               invisible="residual_allocation_ids">
                                No residual allocations. Either all products balanced perfectly
                                or residual calculation has not been run yet
                                (click <strong>Recalculate Residuals</strong>).
                            </p>
                        </page>

                    </notebook>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

</odoo>
