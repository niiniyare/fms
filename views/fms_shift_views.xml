<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Main unified shift form — spec Section 3.3 / Section 10.2
         Layout: Header → Meter Readings → Tank Dips →
                 Attendant Cash → Sales Summary → Residual Allocations
    ================================================================ -->

    <record id="view_fms_shift_form" model="ir.ui.view">
        <field name="name">fms.shift.form</field>
        <field name="model">fms.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">

                <!-- ── Header bar ── -->
                <header>
                    <!-- Supervisors only: shift lifecycle buttons -->
                    <button name="action_open_shift" string="Open Shift"
                            type="object" class="btn-primary"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'draft'"/>
                    <button name="action_start_closing" string="Start Closing"
                            type="object" class="btn-warning"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'open'"/>
                    <button name="action_close_shift" string="Close Shift"
                            type="object" class="btn-danger"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'closing'"
                            confirm="This will lock the shift and post all journal entries. Continue?"/>
                    <button name="action_sync_attendant_cash_lines"
                            string="Sync Attendants"
                            type="object" class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state not in ('open', 'closing')"
                            title="Add cash lines for any attendant assigned to a nozzle but not yet in the Attendant Cash tab"/>
                    <button name="action_refresh_product_sales"
                            string="Refresh Sales Summary"
                            type="object" class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state not in ('open', 'closing')"/>
                    <button name="action_calculate_residuals"
                            string="Recalculate Residuals"
                            type="object" class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state not in ('open', 'closing')"
                            confirm="This will clear and rebuild all residual allocations. Continue?"/>
                    <button name="action_report_fms_shift"
                            string="Print Shift Report"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <button name="action_report_meter_movement"
                            string="Print Meter Movement"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closing,closed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="date"/> —
                            <field name="label"/>
                        </h1>
                    </div>

                    <!-- ── Shift Identity ── -->
                    <group>
                        <group string="Shift Details">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="label" readonly="state != 'draft'"/>
                            <!-- Supervisor optional at open; required at close only if sales exist -->
                            <field name="supervisor_id"
                                   placeholder="Assign any time before closing"/>
                            <!-- Company is always the user's company — read-only -->
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Timestamps">
                            <field name="planned_open"  readonly="1"
                                   invisible="not planned_open"/>
                            <field name="planned_close" readonly="1"
                                   invisible="not planned_close"/>
                            <field name="opening_meter_date" readonly="1"/>
                            <field name="opening_meter_user_id" readonly="1"/>
                            <field name="closing_meter_date" readonly="1"/>
                            <field name="closing_meter_user_id" readonly="1"/>
                            <field name="sales_journal_entry_id" readonly="1"
                                   invisible="not sales_journal_entry_id"
                                   string="Sales GL Entry"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ═══════════════════════════════════════════
                             TAB 1: Pump Meter Readings
                             Opening = readonly (fetched from prev shift)
                             Closing = editable
                        ═══════════════════════════════════════════ -->
                        <page string="Meter Readings" name="meters">
                            <p class="text-muted">
                                Opening totalizers carry over from the previous shift's
                                closing figures — only the closing reading needs to be entered.
                                Qty Sold and Amount are computed automatically.
                            </p>
                            <field name="meter_entry_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Pump Meter Readings">
                                    <field name="pump_id"/>
                                    <field name="nozzle_id"
                                           domain="[('pump_id','=',pump_id)]"/>
                                    <!-- product auto-derived from nozzle — hidden -->
                                    <field name="product_id" column_invisible="1"/>
                                    <field name="attendant_id"
                                           string="Attendant"
                                           domain="[('fms_is_attendant','=',True)]"/>

                                    <!-- Closing readings only (3 meters) -->
                                    <field name="closing_elec_cash"
                                           string="Elec Cash"/>
                                    <field name="closing_elec_volume"
                                           string="Elec Meter (L)"/>
                                    <field name="closing_man_mech"
                                           string="Manual Meter (L)"/>

                                    <!-- RTT -->
                                    <field name="rtt_volume"
                                           string="RTT (L)" optional="show"/>

                                    <!-- Hidden opening fields — carried from nozzle, not displayed -->
                                    <field name="opening_elec_cash" column_invisible="1"/>
                                    <field name="opening_elec_volume" column_invisible="1"/>
                                    <field name="opening_man_mech" column_invisible="1"/>

                                    <!-- Computed net sold (after RTT) -->
                                    <field name="elec_cash_sold" readonly="1"
                                           string="Cash Sold" sum="Total Cash"/>
                                    <field name="qty_sold_elec" readonly="1"
                                           string="Vol Sold (L)" sum="Total L"
                                           optional="show"/>
                                    <field name="qty_sold_man" readonly="1"
                                           string="Man Sold (L)" optional="hide"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <group>
                                <group string="Meter Totals">
                                    <field name="total_meter_sales" readonly="1"
                                           string="Total Meter Sales"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 2: Tank Dips
                             Opening = readonly (fetched from prev shift)
                             Closing = editable
                        ═══════════════════════════════════════════ -->
                        <page string="Tank Dips" name="dips">
                            <p class="text-muted">
                                Enter the closing dip reading for each tank.
                                Opening volume is auto-fetched from the previous shift's log.
                                Variance % exceeding ±0.5% will block shift close (Gate 3).
                            </p>
                            <field name="dip_entry_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Tank Dip Readings">
                                    <field name="location_id" string="Tank"/>
                                    <field name="product_id" readonly="1"
                                           string="Product"/>
                                    <field name="opening_volume" readonly="1"
                                           string="Opening (L)"/>
                                    <field name="closing_volume"
                                           string="Closing Dip (L)"/>
                                    <field name="qty_change" readonly="1"
                                           string="Change (L)"/>
                                    <field name="variance_pct" readonly="1"
                                           string="Variance %"
                                           decoration-success="variance_pct &lt;= 0.5"
                                           decoration-warning="variance_pct &gt; 0.5 and variance_pct &lt;= 2.0"
                                           decoration-danger="variance_pct &gt; 2.0"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 3: Attendant Cash Reconciliation
                             Spec Section 3.3 Screen 3

                             INCOMING (from POS — read-only):
                               POS Sales, MPesa, Card, AR
                             OUTGOING (manual entry):
                               Cash Dropped to Safe  ← ONLY EDITABLE FIELD
                             COMPUTED:
                               Expenses (from vendor bills), Total In, Total Out, Balance

                             Balance must = 0 for shift to close (Gate 1+2).
                        ═══════════════════════════════════════════ -->
                        <page string="Attendant Cash" name="cash">
                            <p class="text-muted">
                                <strong>Meter Sales</strong> is auto-computed from the
                                Electronic Cash meter totals of each nozzle assigned to
                                the attendant in the Meter Readings tab.
                                <strong>Only "Cash Dropped to Safe" requires manual entry.</strong>
                                Balance = Meter Sales − (Cash + MPesa + Card + AR + Expenses).
                                Every attendant's balance must be zero before the shift can close.
                            </p>

                            <!-- POS sessions — filtered to the shift date for easy picking -->
                            <group string="Linked POS Sessions" col="1">
                                <p class="text-muted">
                                    Link POS sessions that ran during this shift.
                                    Sessions are filtered to
                                    <strong><field name="date" readonly="1" nolabel="1"/></strong>.
                                    MPesa, Card and AR payment totals in the Attendant Cash tab
                                    are computed from orders in these sessions.
                                </p>
                                <field name="pos_session_ids"
                                       widget="many2many_tags"
                                       string="POS Sessions"
                                       domain="[('start_at', '&gt;=', date), ('start_at', '&lt;', date + ' 23:59:59')]"
                                       context="{'tree_view_ref': 'point_of_sale.view_pos_session_tree'}"/>
                            </group>

                            <separator string="Per-Attendant Reconciliation"/>

                            <field name="attendant_cash_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Attendant Cash">
                                    <!-- Identity -->
                                    <field name="attendant_id" string="Attendant"/>

                                    <!-- INCOMING — auto-computed from nozzle cash meters -->
                                    <!-- Blind count: hide expected cash while attendant is entering declared cash -->
                                    <field name="reported_sales" readonly="1"
                                           string="Meter Sales"
                                           sum="Total Meter Sales"
                                           column_invisible="parent.state in ('open', 'closing')"/>
                                    <field name="mpesa_amount" readonly="1"
                                           string="MPesa" sum="MPesa Total"
                                           optional="show"/>
                                    <field name="card_amount" readonly="1"
                                           string="Card" sum="Card Total"
                                           optional="show"/>
                                    <field name="ar_amount" readonly="1"
                                           string="AR/Credit" sum="AR Total"
                                           optional="show"/>

                                    <!-- DIRECT SALES RECEIPTS — dry-stock -->
                                    <field name="direct_sales_cash" readonly="1"
                                           string="Dry-Stock Cash" sum="Dry-Stock Cash Total"
                                           optional="show"/>
                                    <field name="direct_sales_digital" readonly="1"
                                           string="Dry-Stock Digital" sum="Dry-Stock Digital Total"
                                           optional="hide"/>

                                    <!-- OUTGOING — expense from GL, cash is MANUAL -->
                                    <field name="expense_amount" readonly="1"
                                           string="Expenses" sum="Expenses Total"
                                           optional="show"/>
                                    <field name="cash_collected"
                                           string="Cash Dropped"
                                           sum="Cash Total"/>

                                    <!-- SUMMARY — all read-only computed -->
                                    <field name="total_in" readonly="1"
                                           string="Total In" sum="Grand In"/>
                                    <field name="total_out" readonly="1"
                                           string="Total Out" sum="Grand Out"/>
                                    <field name="balance" readonly="1"
                                           string="Balance" sum="Net Balance"
                                           decoration-success="balance == 0"
                                           decoration-danger="balance != 0"/>

                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>

                            <!-- FC Cash gate status -->
                            <group>
                                <group string="FC Cash Gate">
                                    <field name="total_reported_sales" readonly="1"
                                           string="Total Meter Sales"/>
                                    <field name="total_meter_sales" readonly="1"
                                           string="Total Meter Sales"/>
                                    <field name="fc_cash_balance" readonly="1"
                                           string="FC Cash Balance"
                                           decoration-success="fc_cash_balance == 0"
                                           decoration-danger="fc_cash_balance != 0"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 4: Sales Summary (read-only)
                             Spec Section 3.3 Screen 4
                        ═══════════════════════════════════════════ -->
                        <page string="Sales Summary" name="sales">
                            <p class="text-muted">
                                Computed rollup of pump meter readings grouped by product.
                                Use "Refresh Sales Summary" button after entering meter readings.
                            </p>
                            <field name="product_sales_ids" readonly="1">
                                <list string="Product Sales">
                                    <field name="product_id"/>
                                    <!-- Volume side -->
                                    <field name="meter_volume"
                                           string="Meter Vol (L)" sum="Total Meter L"/>
                                    <field name="accounted_volume"
                                           string="POS Vol (L)" sum="Total POS L"
                                           optional="show"/>
                                    <field name="volume_residual"
                                           string="Vol Residual (L)"
                                           decoration-success="volume_residual &gt; -0.1 and volume_residual &lt; 0.1"
                                           decoration-warning="volume_residual &gt;= 0.1 or volume_residual &lt;= -0.1"
                                           optional="show"/>
                                    <!-- Cash side -->
                                    <field name="elec_cash_sold"
                                           string="Cash Meter" sum="Total Cash"/>
                                    <field name="pos_cash_collected"
                                           string="POS Total" sum="Total POS"
                                           optional="show"/>
                                    <field name="cash_residual"
                                           string="Cash Residual"
                                           decoration-success="cash_residual &gt; -100 and cash_residual &lt; 100"
                                           decoration-warning="cash_residual &gt;= 100 or cash_residual &lt;= -100"
                                           optional="show"/>
                                    <!-- Allocation result -->
                                    <field name="allocated_volume"
                                           string="Allocated (L)"
                                           optional="hide"/>
                                    <!-- Status -->
                                    <field name="residual_type"
                                           string="Vol Status"
                                           decoration-success="residual_type == 'none'"
                                           decoration-warning="residual_type == 'under'"
                                           decoration-danger="residual_type == 'over'"
                                           optional="show"/>
                                    <field name="price_at_close"
                                           string="Price (/L)" optional="hide"/>
                                    <field name="meter_volume_man"
                                           string="Manual Vol (L)" optional="hide"/>
                                </list>
                            </field>

                            <group>
                                <group string="Shift Totals">
                                    <field name="total_meter_sales" readonly="1"
                                           string="Total Meter Sales"/>
                                    <field name="total_reported_sales" readonly="1"
                                           string="Total Reported Sales"/>
                                    <field name="fc_cash_balance" readonly="1"
                                           string="FC Cash Balance"
                                           decoration-success="fc_cash_balance == 0"
                                           decoration-danger="fc_cash_balance != 0"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 5: Residual Allocations (FMS-003)
                             Auto-populated by residual algorithm.
                             Read-only.
                        ═══════════════════════════════════════════ -->
                        <page string="Residual Allocations" name="residuals">
                            <p class="text-muted">
                                Auto-calculated by the residual allocation algorithm (FMS-003).
                                Records here show how over-reported products were reallocated
                                to under-reported products (e.g., Diesel surplus → Carwash).
                            </p>
                            <field name="residual_allocation_ids" readonly="1">
                                <list string="Residual Allocations">
                                    <field name="source_product_id"
                                           string="From (Over-reported)"/>
                                    <field name="target_product_id"
                                           string="To (Under-reported)"/>
                                    <field name="qty_litres" string="Qty (L)"/>
                                    <field name="amount" string="Amount"
                                           sum="Total Reallocated"/>
                                    <field name="journal_entry_id" optional="hide"
                                           string="GL Entry"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 6: Supervisor Notes
                        ═══════════════════════════════════════════ -->
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Supervisor investigation notes, variance explanations..."/>
                        </page>

                    </notebook>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

</odoo>
