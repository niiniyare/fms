<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Main unified shift form — spec Section 3.3 / Section 10.2
         Tabs: [ Meters ] [ Dips ] [ Non Fuel Sales ] [ Floats / Drops ]
    ================================================================ -->

    <record id="view_fms_shift_form" model="ir.ui.view">
        <field name="name">fms.shift.form</field>
        <field name="model">fms.shift</field>
        <field name="arch" type="xml">
            <form string="Shift">

                <!-- ── Header bar ── -->
                <header>
                    <button name="action_open_shift" string="Open Shift"
                            type="object" class="btn-primary"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'draft'"/>
                    <button name="action_start_closing" string="Start Closing"
                            type="object" class="btn-warning"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'open'"/>
                    <button name="action_close_shift" string="Close Shift"
                            type="object" class="btn-danger"
                            groups="fms.group_fms_supervisor"
                            invisible="state != 'closing'"
                            confirm="This will lock the shift and post all journal entries. Continue?"/>
                    <button name="action_report_fms_shift"
                            string="Print Shift Report"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <button name="action_report_meter_movement"
                            string="Print Meter Movement"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <button name="action_writeoff_fc_variance"
                            string="Write Off FC Variance"
                            type="object"
                            class="btn-warning"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft' or state == 'closed'"
                            confirm="This will post a journal entry to zero out the FC Cash variance. Continue?"/>
                    <button name="action_report_fc_cash_recon"
                            string="FC Cash Recon Report"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <button name="action_report_sales_register"
                            string="Sales Register"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <button name="action_report_fms_attendant_statement"
                            string="Attendant Statements"
                            type="object"
                            class="btn-secondary"
                            groups="fms.group_fms_supervisor"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closing,closed"/>
                </header>

                <sheet>
                    <!-- state must be declared in sheet for readonly expressions to resolve -->
                    <field name="state" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="date"/> —
                            <field name="label"/>
                        </h1>
                    </div>

                    <!-- ── Shift Identity ── -->
                    <group>
                        <group string="Shift Details">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="label" readonly="state != 'draft'"/>
                            <field name="supervisor_id"
                                   placeholder="Assign any time before closing"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Timestamps">
                            <field name="planned_open"  readonly="1"
                                   invisible="not planned_open"/>
                            <field name="planned_close" readonly="1"
                                   invisible="not planned_close"/>
                            <field name="opening_meter_date" readonly="1"/>
                            <field name="opening_meter_user_id" readonly="1"/>
                            <field name="closing_meter_date" readonly="1"/>
                            <field name="closing_meter_user_id" readonly="1"/>
                            <field name="sales_journal_entry_id" readonly="1"
                                   invisible="not sales_journal_entry_id"
                                   string="Sales GL Entry"/>
                        </group>
                    </group>

                    <!-- ── FC Cash status bar (always visible when open/closing/closed) ── -->
                    <group invisible="state == 'draft'" class="o_group_col_4">
                        <group string="Fuel Sales">
                            <field name="total_fuel_sales" readonly="1"
                                   string="Fuel Sales"
                                   widget="monetary"/>
                        </group>
                        <group string="Non Fuel Sales">
                            <field name="total_nonfuel_sales" readonly="1"
                                   string="Non Fuel Sales"
                                   widget="monetary"/>
                        </group>
                        <group string="Total Sales">
                            <field name="total_all_sales" readonly="1"
                                   string="Total Sales"
                                   widget="monetary"/>
                        </group>
                        <group string="FC Cash Variance">
                            <field name="fc_cash_balance_total" readonly="1"
                                   string="FC Cash (must = 0)"
                                   widget="monetary"
                                   decoration-danger="fc_cash_balance_total != 0"
                                   decoration-success="fc_cash_balance_total == 0"/>
                            <field name="fc_writeoff_account_id"
                                   string="Write-off Account"
                                   invisible="fc_cash_balance_total == 0 and not fc_variance_writeoff"
                                   placeholder="Cash Over/Short account…"/>
                            <field name="fc_variance_writeoff" readonly="1"
                                   string="Written Off"
                                   widget="monetary"
                                   invisible="fc_variance_writeoff == 0"/>
                            <field name="fc_writeoff_move_id" readonly="1"
                                   string="Write-off JE"
                                   invisible="not fc_writeoff_move_id"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ═══════════════════════════════════════════
                             TAB 1: Pump Meter Readings
                        ═══════════════════════════════════════════ -->
                        <page string="Meters" name="meters">
                            <field name="meter_entry_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Pump Meter Readings">
                                    <field name="pump_id"/>
                                    <field name="nozzle_id"
                                           domain="[('pump_id','=',pump_id)]"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="attendant_id"
                                           string="Attendant"
                                           domain="[('fms_is_attendant','=',True)]"/>
                                    <field name="opening_elec_cash"
                                           string="Open Cash" readonly="1"
                                           optional="hide"/>
                                    <field name="opening_elec_volume"
                                           string="Open Vol (L)" readonly="1"
                                           optional="hide"/>
                                    <field name="closing_elec_cash"
                                           string="Close Cash"/>
                                    <field name="closing_elec_volume"
                                           string="Close Vol (L)"/>
                                    <field name="closing_man_mech"
                                           string="Manual (L)" optional="show"/>
                                    <field name="rtt_volume"
                                           string="RTT (L)" optional="show"/>
                                    <field name="elec_cash_sold" readonly="1"
                                           string="Cash Sold" sum="Total"/>
                                    <field name="qty_sold_elec" readonly="1"
                                           string="Vol Sold (L)" sum="Litres"
                                           optional="show"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>

                            <!-- Subtotals: by product and by attendant -->
                            <div class="o_horizontal_separator mt-3">By Product</div>
                            <field name="product_sales_ids" readonly="1"
                                   context="{'default_shift_id': id}">
                                <list string="Meter — By Product"
                                      create="false" delete="false" edit="false"
                                      decoration-muted="meter_volume == 0">
                                    <field name="product_id" string="Product"/>
                                    <field name="meter_volume" string="Vol Sold (L)"
                                           sum="Total Litres"/>
                                    <field name="elec_cash_sold" string="Cash"
                                           sum="Total Cash"/>
                                    <field name="meter_revenue" string="Vol × Price"
                                           optional="show" sum="Revenue"/>
                                </list>
                            </field>

                            <div class="o_horizontal_separator mt-3">By Attendant</div>
                            <field name="attendant_cash_ids" readonly="1"
                                   context="{'default_shift_id': id}">
                                <list string="Meter — By Attendant"
                                      create="false" delete="false" edit="false">
                                    <field name="attendant_id" string="Attendant"/>
                                    <field name="reported_sales" string="Fuel Sales"
                                           sum="Total"/>
                                </list>
                            </field>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 2: Tank Dips
                        ═══════════════════════════════════════════ -->
                        <page string="Dips" name="dips">
                            <field name="dip_entry_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Tank Dip Readings">
                                    <field name="location_id" string="Tank"
                                           readonly="1"/>
                                    <field name="product_id" readonly="1"
                                           string="Product"/>
                                    <field name="opening_volume" readonly="1"
                                           string="Opening (L)"/>
                                    <field name="closing_volume"
                                           string="Closing Dip (L)"/>
                                    <field name="book_stock_open" readonly="1"
                                           string="Book Stock (L)" optional="show"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>

                            <!-- Subtotals: by product -->
                            <div class="o_horizontal_separator mt-3">Dip Summary by Product</div>
                            <field name="dip_entry_ids" readonly="1"
                                   context="{'default_shift_id': id}">
                                <list string="Dips — Summary"
                                      create="false" delete="false" edit="false">
                                    <field name="product_id" string="Product"/>
                                    <field name="opening_volume" string="Opening (L)"
                                           sum="Total Opening"/>
                                    <field name="closing_volume" string="Closing (L)"
                                           sum="Total Closing"/>
                                </list>
                            </field>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 3: Non Fuel Sales
                             Goods (lubes, filters) + Services (carwash, etc.)
                        ═══════════════════════════════════════════ -->
                        <page string="Non Fuel Sales" name="non_fuel">
                            <field name="fc_line_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Non Fuel Sales Lines">
                                    <field name="attendant_id" string="Attendant"
                                           domain="[('fms_is_attendant','=',True)]"
                                           options="{'no_create': True}"/>
                                    <field name="product_id" string="Product / Service"
                                           options="{'no_create': True}"/>
                                    <field name="line_type" string="Type"
                                           readonly="1"/>
                                    <field name="opening_qty" string="Opening"
                                           readonly="1"
                                           invisible="line_type == 'service'"
                                           optional="show"/>
                                    <field name="delivery_qty" string="Received"
                                           invisible="line_type == 'service'"
                                           optional="show"/>
                                    <field name="closing_qty" string="Closing"
                                           invisible="line_type == 'service'"
                                           optional="show"/>
                                    <field name="qty_sold" string="Qty Sold"
                                           readonly="1"
                                           invisible="line_type == 'service'"
                                           optional="show" sum="Qty Sold"/>
                                    <field name="price_unit" string="Price"
                                           invisible="line_type == 'service'"
                                           optional="show"/>
                                    <field name="amount" string="Amount"
                                           invisible="line_type == 'goods'"/>
                                    <field name="sales_amount" string="Sales Amount"
                                           readonly="1" sum="Total Sales"/>
                                </list>
                            </field>

                            <group class="mt-3">
                                <group string="Non Fuel Totals">
                                    <field name="total_fc_sales" readonly="1"
                                           string="Total Non Fuel Sales"
                                           widget="monetary"/>
                                </group>
                            </group>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 5: FC Cash Reconciliation
                             Per-attendant captured vs collected breakdown
                        ═══════════════════════════════════════════ -->
                        <page string="FC Cash Recon" name="fc_cash_recon"
                              invisible="state == 'draft'">
                            <field name="attendant_cash_ids" readonly="1"
                                   context="{'default_shift_id': id}">
                                <list string="FC Cash Reconciliation"
                                      create="false" delete="false" edit="false"
                                      decoration-danger="fc_variance != 0"
                                      decoration-success="fc_variance == 0">
                                    <field name="attendant_id" string="Attendant"/>

                                    <!-- DR: Captured -->
                                    <field name="fc_meter_sales" string="Fuel Sales"
                                           sum="Fuel Sales"/>
                                    <field name="fc_nonfuel_sales" string="Non Fuel"
                                           sum="Non Fuel"/>
                                    <field name="fc_float_amount" string="Floats Issued"
                                           optional="show" sum="Floats"/>
                                    <field name="fc_cust_receipt" string="Cust Receipts"
                                           optional="show" sum="Cust Rcpts"/>
                                    <field name="fc_captured" string="Total Captured"
                                           sum="Total Captured"/>

                                    <!-- CR: Collected -->
                                    <field name="fc_invoice_amount" string="Invoices"
                                           optional="show" sum="Invoices"/>
                                    <field name="fc_receipt_amount" string="Receipts"
                                           optional="show" sum="Receipts"/>
                                    <field name="fc_drop_amount" string="Cash Drops"
                                           optional="show" sum="Drops"/>
                                    <field name="fc_expense_amount" string="Expenses"
                                           optional="show" sum="Expenses"/>
                                    <field name="fc_collected" string="Total Collected"
                                           sum="Total Collected"/>

                                    <field name="fc_variance" string="Variance"
                                           sum="Total Variance"/>
                                </list>
                            </field>
                        </page>

                        <!-- ═══════════════════════════════════════════
                             TAB 4: Floats / Drops
                             Cash floats issued + all cash drops in one view
                        ═══════════════════════════════════════════ -->
                        <page string="Floats / Drops" name="floats_drops">
                            <field name="cash_movement_ids"
                                   readonly="state == 'closed'"
                                   context="{'default_shift_id': id}">
                                <list editable="bottom" string="Floats and Drops"
                                      decoration-info="float_amount &gt; 0"
                                      decoration-warning="drop_amount &gt; 0">
                                    <field name="attendant_id" string="Attendant"
                                           domain="[('fms_is_attendant','=',True)]"
                                           options="{'no_create': True}"/>
                                    <field name="float_amount" string="Float"
                                           sum="Total Floats"/>
                                    <field name="drop_amount" string="Drop"
                                           sum="Total Drops"/>
                                    <field name="date" string="Dropped At"/>
                                    <field name="note" string="Note" optional="show"/>
                                    <field name="payment_id" string="Payment"
                                           readonly="1" optional="show"/>
                                </list>
                            </field>

                            <group class="mt-3">
                                <group string="FC Cash Variance by Attendant">
                                    <field name="fc_cash_balance_total" readonly="1"
                                           string="Total FC Variance (must = 0)"
                                           widget="monetary"
                                           decoration-danger="fc_cash_balance_total != 0"
                                           decoration-success="fc_cash_balance_total == 0"/>
                                </group>
                            </group>
                        </page>

                    </notebook>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

</odoo>
