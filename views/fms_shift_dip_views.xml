<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Standalone dip entry views (used in Reporting → Dip Entries)
    ================================================================ -->

    <record id="view_fms_shift_dip_entry_tree" model="ir.ui.view">
        <field name="name">fms.shift.dip.entry.tree</field>
        <field name="model">fms.shift.dip.entry</field>
        <field name="arch" type="xml">
            <list string="Dip Entries">
                <field name="shift_id"/>
                <field name="location_id" string="Tank"/>
                <field name="product_id"/>
                <field name="opening_volume" string="Opening (L)" optional="show"/>
                <field name="book_stock_open" string="Book Stock (L)" optional="show"/>
                <field name="closing_volume" string="Closing Dip (L)"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fms_shift_dip_entry_form" model="ir.ui.view">
        <field name="name">fms.shift.dip.entry.form</field>
        <field name="model">fms.shift.dip.entry</field>
        <field name="arch" type="xml">
            <form string="Dip Entry">
                <sheet>
                    <group>
                        <group string="Tank">
                            <field name="shift_id"/>
                            <field name="location_id" string="Tank"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group string="Volumes">
                            <field name="opening_volume" readonly="1"/>
                            <field name="book_stock_open" readonly="1"/>
                            <field name="closing_volume"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
