<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         R2 · Daily Station Report — on-screen views
    ================================================================ -->

    <record id="view_fms_daily_station_list" model="ir.ui.view">
        <field name="name">fms.report.daily.station.list</field>
        <field name="model">fms.report.daily.station</field>
        <field name="arch" type="xml">
            <list string="Daily Station Report" create="false" edit="false" delete="false"
                  decoration-muted="qty_litres == 0">
                <field name="shift_date"/>
                <field name="shift_label"/>
                <field name="product_id"/>
                <field name="qty_litres"  string="Volume (L)"   sum="Volume (L)"/>
                <field name="amount_kes"  string="Sales"  sum="Sales"/>
                <field name="rtt_volume"  string="RTT (L)"      sum="RTT (L)" optional="hide"/>
                <field name="supervisor_id" optional="hide"/>
                <field name="company_id"  groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fms_daily_station_pivot" model="ir.ui.view">
        <field name="name">fms.report.daily.station.pivot</field>
        <field name="model">fms.report.daily.station</field>
        <field name="arch" type="xml">
            <pivot string="Daily Station" disable_linking="false">
                <field name="shift_date"  type="row"/>
                <field name="shift_label" type="row"/>
                <field name="product_id"  type="row"/>
                <field name="qty_litres"  type="measure"/>
                <field name="amount_kes"  type="measure"/>
                <field name="rtt_volume"  type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_fms_daily_station_graph" model="ir.ui.view">
        <field name="name">fms.report.daily.station.graph</field>
        <field name="model">fms.report.daily.station</field>
        <field name="arch" type="xml">
            <graph string="Daily Sales" type="bar" stacked="1">
                <field name="shift_date" type="row"/>
                <field name="amount_kes" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_fms_daily_station_report" model="ir.actions.act_window">
        <field name="name">Daily Station Report</field>
        <field name="res_model">fms.report.daily.station</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No closed shifts found.</p>
            <p>Close a shift to see its sales here. Make sure shifts are in
               <b>Closed</b> state — open or draft shifts are excluded.</p>
        </field>
    </record>

    <!-- ================================================================
         R3 · Wetstock Reconciliation — on-screen views
    ================================================================ -->

    <record id="view_fms_wetstock_list" model="ir.ui.view">
        <field name="name">fms.report.wetstock.list</field>
        <field name="model">fms.report.wetstock</field>
        <field name="arch" type="xml">
            <list string="Wetstock Reconciliation" create="false" edit="false" delete="false"
                  decoration-danger="variance_pct &gt; 0.5"
                  decoration-warning="variance_pct &gt; 0.2 and variance_pct &lt;= 0.5">
                <field name="shift_date"/>
                <field name="shift_label"/>
                <field name="tank_id"      string="Tank"/>
                <field name="product_id"/>
                <field name="opening_vol"  string="Opening (L)"      sum="Opening (L)"/>
                <field name="metered_sale" string="Metered Sale (L)" sum="Metered (L)"/>
                <field name="book_stock"   string="Book Stock (L)"/>
                <field name="closing_vol"  string="Closing Dip (L)"  sum="Closing (L)"/>
                <field name="variance_l"   string="Variance (L)"     sum="Variance (L)"/>
                <field name="variance_pct" string="Variance %"       widget="float" digits="[16,4]"/>
            </list>
        </field>
    </record>

    <record id="view_fms_wetstock_pivot" model="ir.ui.view">
        <field name="name">fms.report.wetstock.pivot</field>
        <field name="model">fms.report.wetstock</field>
        <field name="arch" type="xml">
            <pivot string="Wetstock">
                <field name="tank_id"      type="row"/>
                <field name="product_id"   type="row"/>
                <field name="shift_date"   type="col"/>
                <field name="metered_sale" type="measure"/>
                <field name="variance_l"   type="measure"/>
                <field name="variance_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_fms_wetstock_report" model="ir.actions.act_window">
        <field name="name">Wetstock Reconciliation</field>
        <field name="res_model">fms.report.wetstock</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{}</field>
    </record>

    <!-- ================================================================
         R4 · Attendant Sales & Cash — on-screen views
    ================================================================ -->

    <record id="view_fms_attendant_sales_list" model="ir.ui.view">
        <field name="name">fms.report.attendant.sales.list</field>
        <field name="model">fms.report.attendant.sales</field>
        <field name="arch" type="xml">
            <list string="Attendant Sales &amp; Cash" create="false" edit="false" delete="false"
                  decoration-danger="balance &gt; 0.01"
                  decoration-success="balance &lt;= 0.01 and balance &gt;= -0.01">
                <field name="shift_date"/>
                <field name="shift_label"/>
                <field name="attendant_id"/>
                <field name="reported_sales" string="Reported"  sum="Reported"/>
                <field name="mpesa_amount"   string="MPesa"     sum="MPesa"     optional="show"/>
                <field name="card_amount"    string="Card"      sum="Card"      optional="show"/>
                <field name="ar_amount"      string="AR"        sum="AR"        optional="show"/>
                <field name="expense_amount" string="Expenses"  sum="Expenses"  optional="show"/>
                <field name="cash_collected" string="Cash Drop" sum="Cash Drop"/>
                <field name="balance"        string="Shortage"  sum="Shortage"
                       decoration-danger="balance &gt; 0.01"
                       decoration-success="balance &lt;= 0.01 and balance &gt;= -0.01"/>
            </list>
        </field>
    </record>

    <record id="view_fms_attendant_sales_pivot" model="ir.ui.view">
        <field name="name">fms.report.attendant.sales.pivot</field>
        <field name="model">fms.report.attendant.sales</field>
        <field name="arch" type="xml">
            <pivot string="Attendant Sales">
                <field name="attendant_id"   type="row"/>
                <field name="shift_date"     type="col"/>
                <field name="reported_sales" type="measure"/>
                <field name="cash_collected" type="measure"/>
                <field name="balance"        type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_fms_attendant_sales_report" model="ir.actions.act_window">
        <field name="name">Attendant Sales &amp; Cash</field>
        <field name="res_model">fms.report.attendant.sales</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_group_attendant': 1}</field>
    </record>

    <!-- ================================================================
         Search views — shared filter conventions from §1
    ================================================================ -->

    <record id="view_fms_daily_station_search" model="ir.ui.view">
        <field name="name">fms.report.daily.station.search</field>
        <field name="model">fms.report.daily.station</field>
        <field name="arch" type="xml">
            <search string="Daily Station Report">
                <field name="shift_date"   string="Date"/>
                <field name="product_id"/>
                <field name="supervisor_id"/>
                <filter string="Today"      name="today"
                        domain="[('shift_date','=', context_today())]"/>
                <filter string="Yesterday"  name="yesterday"
                        domain="[('shift_date','=', (context_today() + relativedelta(days=-1)))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('shift_date','&gt;=', context_today() + relativedelta(day=1))]"/>
                <separator/>
                <filter string="Day Shift"     name="day"     domain="[('shift_label','=','day')]"/>
                <filter string="Evening Shift" name="evening" domain="[('shift_label','=','evening')]"/>
                <filter string="Night Shift"   name="night"   domain="[('shift_label','=','night')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Date"      name="group_date"    context="{'group_by':'shift_date'}"/>
                    <filter string="Period"    name="group_label"   context="{'group_by':'shift_label'}"/>
                    <filter string="Product"   name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Supervisor" name="group_sup"    context="{'group_by':'supervisor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fms_wetstock_search" model="ir.ui.view">
        <field name="name">fms.report.wetstock.search</field>
        <field name="model">fms.report.wetstock</field>
        <field name="arch" type="xml">
            <search string="Wetstock Reconciliation">
                <field name="shift_date" string="Date"/>
                <field name="tank_id"    string="Tank"/>
                <field name="product_id"/>
                <filter string="Variance &gt; 0.5%" name="exception"
                        domain="[('variance_pct','&gt;',0.5)]"/>
                <filter string="Last 30 Days" name="last30"
                        domain="[('shift_date','&gt;=',(context_today() + relativedelta(days=-30)))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Tank"    name="group_tank"    context="{'group_by':'tank_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Date"    name="group_date"    context="{'group_by':'shift_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fms_attendant_sales_search" model="ir.ui.view">
        <field name="name">fms.report.attendant.sales.search</field>
        <field name="model">fms.report.attendant.sales</field>
        <field name="arch" type="xml">
            <search string="Attendant Sales &amp; Cash">
                <field name="attendant_id"/>
                <field name="shift_date" string="Date"/>
                <filter string="Shortages Only" name="shortages"
                        domain="[('balance','&gt;',0.01)]"/>
                <filter string="This Month" name="this_month"
                        domain="[('shift_date','&gt;=',context_today() + relativedelta(day=1))]"/>
                <separator/>
                <filter string="Day Shift"     name="day"     domain="[('shift_label','=','day')]"/>
                <filter string="Evening Shift" name="evening" domain="[('shift_label','=','evening')]"/>
                <filter string="Night Shift"   name="night"   domain="[('shift_label','=','night')]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter string="Attendant" name="group_attendant" context="{'group_by':'attendant_id'}"/>
                    <filter string="Date"      name="group_date"      context="{'group_by':'shift_date'}"/>
                    <filter string="Period"    name="group_label"     context="{'group_by':'shift_label'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         Reporting sub-menu items — parent menu_fms_reporting defined in
         fms_shift_list_views.xml (sequence 90).  Meter Log and Dip Log
         entries already exist there; only new report items added here.
    ================================================================ -->

    <!-- menus moved to views/fms_menus.xml -->

    <!-- ================================================================
         R5 · Stock Position &amp; Days of Cover
    ================================================================ -->

    <record id="view_fms_stock_position_list" model="ir.ui.view">
        <field name="name">fms.report.stock.position.list</field>
        <field name="model">fms.report.stock.position</field>
        <field name="arch" type="xml">
            <list string="Stock Position &amp; Days of Cover"
                  create="false" edit="false" delete="false"
                  decoration-danger="reorder_flag == True"
                  decoration-warning="days_cover != False and days_cover &lt;= (reorder_point_days * 1.5) and not reorder_flag">
                <field name="tank_name"         string="Tank"/>
                <field name="product_id"        string="Product"/>
                <field name="current_stock"     string="Stock (L)"    digits="[16,0]"/>
                <field name="tank_capacity"     string="Capacity (L)" digits="[16,0]" optional="hide"/>
                <field name="ullage"            string="Ullage (L)"   digits="[16,0]" optional="hide"/>
                <field name="run_rate_7d"       string="Run Rate 7d (L/day)" digits="[16,0]"/>
                <field name="run_rate_30d"      string="Run Rate 30d (L/day)" digits="[16,0]" optional="hide"/>
                <field name="days_cover"        string="Days Cover"   digits="[16,1]"
                       decoration-danger="reorder_flag == True"
                       decoration-warning="days_cover != False and days_cover &lt;= (reorder_point_days * 1.5) and not reorder_flag"/>
                <field name="reorder_point_days" string="Reorder At (days)" optional="hide"/>
                <field name="reorder_flag"       string="Reorder?" widget="boolean" optional="hide"/>
                <!-- hidden helper for decoration -->
                <field name="reorder_flag"       invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fms_stock_position_kanban" model="ir.ui.view">
        <field name="name">fms.report.stock.position.kanban</field>
        <field name="model">fms.report.stock.position</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false">
                <field name="tank_name"/>
                <field name="product_id"/>
                <field name="current_stock"/>
                <field name="tank_capacity"/>
                <field name="days_cover"/>
                <field name="reorder_point_days"/>
                <field name="reorder_flag"/>
                <field name="run_rate_7d"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_kanban_card {{ record.reorder_flag.raw_value ? 'border-danger' : '' }}">
                            <div class="o_kanban_card_header">
                                <strong><t t-esc="record.tank_name.value"/></strong>
                                <span class="badge"
                                      t-attf-class="{{ record.reorder_flag.raw_value ? 'bg-danger' : 'bg-success' }}">
                                    <t t-esc="record.reorder_flag.raw_value ? 'REORDER' : 'OK'"/>
                                </span>
                            </div>
                            <div class="o_kanban_card_content">
                                <div><b>Product:</b> <t t-esc="record.product_id.value"/></div>
                                <div><b>Stock:</b> <t t-esc="record.current_stock.value"/> L</div>
                                <div><b>Days Cover:</b>
                                    <t t-if="record.days_cover.raw_value">
                                        <t t-esc="record.days_cover.value"/>
                                    </t>
                                    <t t-else="">—</t>
                                </div>
                                <div><b>7d Run Rate:</b> <t t-esc="record.run_rate_7d.value"/> L/day</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_fms_stock_position_search" model="ir.ui.view">
        <field name="name">fms.report.stock.position.search</field>
        <field name="model">fms.report.stock.position</field>
        <field name="arch" type="xml">
            <search string="Stock Position">
                <field name="tank_name" string="Tank"/>
                <field name="product_id"/>
                <filter string="Reorder Now" name="reorder"
                        domain="[('reorder_flag','=',True)]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fms_stock_position" model="ir.actions.act_window">
        <field name="name">Stock Position &amp; Days of Cover</field>
        <field name="res_model">fms.report.stock.position</field>
        <field name="view_mode">kanban,list</field>
        <field name="context">{'search_default_reorder': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No fuel tanks configured.<br/>
                Mark a stock location as a fuel tank and assign a fuel product.
            </p>
        </field>
    </record>

    <!-- menu moved to views/fms_menus.xml -->

</odoo>
