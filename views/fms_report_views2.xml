                <field name="nozzle_id" string="Nozzle"/>
                <field name="product_id" string="Product"/>
                <field name="qty_sold_elec" string="Volume (L)" sum="Total"/>
                <field name="elec_cash_sold" string="Value (KES)" sum="Total"/>
                <field name="rtt_volume" string="RTT (L)" optional="show" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_fms_attendant_category_search" model="ir.ui.view">
        <field name="name">fms.report.attendant.category.search</field>
        <field name="model">fms.report.attendant.category</field>
        <field name="arch" type="xml">
            <search string="Attendant Sales by Category">
                <field name="attendant_id"/>
                <field name="product_id"/>
                <field name="nozzle_id"/>
                <filter string="This Month" name="this_month"
                        domain="[('shift_date', '&gt;=', context_today() + relativedelta(day=1))]"/>
                <separator/>
                <group string="Group By">
                    <filter string="Attendant" name="group_attendant" context="{'group_by': 'attendant_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'shift_date:month'}"/>
                    <filter string="Shift Period" name="group_label" context="{'group_by': 'shift_label'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fms_attendant_category" model="ir.actions.act_window">
        <field name="name">Sales by Category</field>
        <field name="res_model">fms.report.attendant.category</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_attendant': 1}</field>
    </record>

    <menuitem id="menu_fms_report_attendant_category"
              name="Sales by Category"
              parent="menu_fms_section_attendants"
              action="action_fms_attendant_category"
              sequence="30"/>


    <!-- ================================================================
         R26 · Shortage & Overage Ledger  (restricted — supervisor+)
    ================================================================ -->

    <record id="view_fms_shortage_list" model="ir.ui.view">
        <field name="name">fms.report.shortage.list</field>
        <field name="model">fms.report.shortage</field>
        <field name="arch" type="xml">
            <list string="Shortage &amp; Overage Ledger" create="false" edit="false" delete="false"
                  default_order="attendant_name, shift_date"
                  decoration-danger="balance &lt; -10"
                  decoration-success="balance &gt; 0">
                <field name="attendant_id" string="Attendant"/>
                <field name="shift_date" string="Date"/>
                <field name="shift_label" string="Period"/>
                <field name="supervisor_id" string="Supervisor" optional="show"/>
                <field name="reported_sales" string="Expected (KES)"/>
                <field name="cash_collected" string="Declared (KES)"/>
                <field name="mpesa_amount" string="MPesa" optional="show"/>
                <field name="card_amount" string="Card" optional="show"/>
                <field name="ar_amount" string="AR" optional="show"/>
                <field name="balance" string="Shortage/Overage (KES)"
                       decoration-danger="balance &lt; -10"
                       decoration-success="balance &gt; 0"/>
                <field name="cumulative_balance" string="Cumulative (KES)"
                       decoration-danger="cumulative_balance &lt; -100"/>
                <field name="shift_id" string="Shift" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fms_shortage_pivot" model="ir.ui.view">
        <field name="name">fms.report.shortage.pivot</field>
        <field name="model">fms.report.shortage</field>
        <field name="arch" type="xml">
            <pivot string="Shortage &amp; Overage">
                <field name="attendant_id" type="row"/>
                <field name="shift_date" type="row" interval="month"/>
                <field name="reported_sales" type="measure" string="Expected (KES)"/>
                <field name="balance" type="measure" string="Shortage (KES)"/>
                <field name="cumulative_balance" type="measure" string="Cumulative (KES)"/>
            </pivot>
        </field>
    </record>

    <record id="view_fms_shortage_search" model="ir.ui.view">
        <field name="name">fms.report.shortage.search</field>
        <field name="model">fms.report.shortage</field>
        <field name="arch" type="xml">
            <search string="Shortage &amp; Overage Ledger">
                <field name="attendant_id"/>
                <filter string="Shortages Only" name="short"
                        domain="[('balance', '&lt;', -1)]"/>
                <filter string="Overages Only" name="over"
                        domain="[('balance', '&gt;', 1)]"/>
                <filter string="Balanced" name="clear"
                        domain="[('balance', '&gt;=', -1), ('balance', '&lt;=', 1)]"/>
                <filter string="This Month" name="this_month"
                        domain="[('shift_date', '&gt;=', context_today() + relativedelta(day=1))]"/>
                <filter string="Last 30 Days" name="last_30"
                        domain="[('shift_date', '&gt;=', context_today() + relativedelta(days=-30))]"/>
                <separator/>
                <group string="Group By">
                    <filter string="Attendant" name="group_attendant" context="{'group_by': 'attendant_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'shift_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fms_shortage" model="ir.actions.act_window">
        <field name="name">Shortage &amp; Overage Ledger</field>
        <field name="res_model">fms.report.shortage</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_short': 1, 'search_default_group_attendant': 1}</field>
    </record>

    <menuitem id="menu_fms_report_shortage"
              name="Shortage &amp; Overage Ledger"
              parent="menu_fms_section_attendants"
              action="action_fms_shortage"
              sequence="40"
              groups="fms.group_fms_supervisor"/>


    <!-- ================================================================
         R27 · Attendant Performance
    ================================================================ -->

    <record id="view_fms_attendant_perf_list" model="ir.ui.view">
        <field name="name">fms.report.attendant.perf.list</field>
        <field name="model">fms.report.attendant.perf</field>
        <field name="arch" type="xml">
            <list string="Attendant Performance" create="false" edit="false" delete="false"
                  default_order="total_qty desc">
                <field name="attendant_id" string="Attendant"/>
                <field name="shift_count" string="Shifts"/>
                <field name="total_qty" string="Total Volume (L)" sum="Total"/>
                <field name="avg_qty" string="Avg L/Shift"/>
                <field name="accuracy_pct" string="Cash Accuracy %"
                       decoration-success="accuracy_pct &gt;= 95"
                       decoration-warning="accuracy_pct &lt; 95 and accuracy_pct &gt;= 80"
                       decoration-danger="accuracy_pct &lt; 80"/>
                <field name="shortage_shifts" string="Short Shifts"
                       decoration-danger="shortage_shifts &gt; 3"/>
                <field name="overage_shifts" string="Over Shifts" optional="show"/>
                <field name="total_shortage" string="Total Shortage (KES)"
                       decoration-danger="total_shortage &gt; 1000" optional="show"/>
                <field name="total_rtt" string="Total RTT (L)" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_fms_attendant_perf_pivot" model="ir.ui.view">
        <field name="name">fms.report.attendant.perf.pivot</field>
        <field name="model">fms.report.attendant.perf</field>
        <field name="arch" type="xml">
            <pivot string="Attendant Performance">
                <field name="attendant_id" type="row"/>
                <field name="shift_count" type="measure" string="Shifts"/>
                <field name="total_qty" type="measure" string="Volume (L)"/>
                <field name="accuracy_pct" type="measure" string="Accuracy %"/>
                <field name="total_shortage" type="measure" string="Shortage (KES)"/>
            </pivot>
        </field>
    </record>

    <record id="view_fms_attendant_perf_search" model="ir.ui.view">
        <field name="name">fms.report.attendant.perf.search</field>
        <field name="model">fms.report.attendant.perf</field>
        <field name="arch" type="xml">
            <search string="Attendant Performance">
                <field name="attendant_id"/>
                <filter string="High Shortage (&gt;3 shifts)" name="high_shortage"
                        domain="[('shortage_shifts', '&gt;', 3)]"/>
                <filter string="Low Accuracy (&lt;80%)" name="low_accuracy"
                        domain="[('accuracy_pct', '&lt;', 80)]"/>
            </search>
        </field>
    </record>

    <record id="action_fms_attendant_perf" model="ir.actions.act_window">
        <field name="name">Attendant Performance</field>
        <field name="res_model">fms.report.attendant.perf</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_fms_report_attendant_perf"
              name="Attendant Performance"
              parent="menu_fms_section_attendants"
              action="action_fms_attendant_perf"
              sequence="50"/>


    <!-- ================================================================
         R28 · Attendant Risk & Anomaly  (restricted — supervisor+)
    ================================================================ -->

    <record id="view_fms_risk_anomaly_list" model="ir.ui.view">
        <field name="name">fms.report.risk.anomaly.list</field>
        <field name="model">fms.report.risk.anomaly</field>
        <field name="arch" type="xml">
            <list string="Risk &amp; Anomaly" create="false" edit="false" delete="false"
                  default_order="risk_score desc"
                  decoration-danger="risk_score &gt; 10"
                  decoration-warning="risk_score &gt; 5 and risk_score &lt;= 10">
                <field name="attendant_id" string="Attendant"/>
                <field name="shift_count" string="Shifts"/>
                <field name="shortage_shifts" string="Short Shifts"
                       decoration-danger="shortage_shifts &gt; 5"/>
                <field name="consecutive_short" string="Max Consecutive Short"
                       decoration-danger="consecutive_short &gt; 3"/>
                <field name="total_shortage" string="Total Shortage (KES)"
                       decoration-danger="total_shortage &gt; 2000"/>
                <field name="avg_shortage" string="Avg Shortage/Shift (KES)" optional="show"/>
                <field name="round_readings" string="Round Readings"
                       decoration-warning="round_readings &gt; 3" optional="show"/>
                <field name="high_variance_shifts" string="High Mech Variance"
                       decoration-warning="high_variance_shifts &gt; 2" optional="show"/>
                <field name="rtt_shifts" string="RTT Shifts" optional="show"/>
                <field name="risk_score" string="Risk Score"
                       decoration-danger="risk_score &gt; 10"
                       decoration-warning="risk_score &gt; 5"/>
            </list>
        </field>
    </record>

    <record id="view_fms_risk_anomaly_search" model="ir.ui.view">
        <field name="name">fms.report.risk.anomaly.search</field>
        <field name="model">fms.report.risk.anomaly</field>
        <field name="arch" type="xml">
            <search string="Risk &amp; Anomaly">
                <field name="attendant_id"/>
                <filter string="High Risk (score &gt; 10)" name="high_risk"
                        domain="[('risk_score', '&gt;', 10)]"/>
                <filter string="Medium Risk (score &gt; 5)" name="med_risk"
                        domain="[('risk_score', '&gt;', 5)]"/>
                <filter string="Any Anomaly" name="any_anomaly"
                        domain="[('risk_score', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <record id="action_fms_risk_anomaly" model="ir.actions.act_window">
        <field name="name">Risk &amp; Anomaly</field>
        <field name="res_model">fms.report.risk.anomaly</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_any_anomaly': 1}</field>
    </record>

    <menuitem id="menu_fms_report_risk_anomaly"
              name="Risk &amp; Anomaly"
              parent="menu_fms_section_attendants"
              action="action_fms_risk_anomaly"
              sequence="60"
              groups="fms.group_fms_supervisor"/>


