        </field>
    </record>

    <record id="action_fms_gl_reconciliation" model="ir.actions.act_window">
        <field name="name">GL Reconciliation Journal</field>
        <field name="res_model">fms.report.gl.reconciliation</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_shift': 1}</field>
    </record>

    <menuitem id="menu_fms_report_gl_reconciliation"
              name="GL Reconciliation Journal"
