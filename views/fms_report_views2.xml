<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         R7 · Meter Variance Log
    ================================================================ -->

    <record id="view_fms_meter_variance_list" model="ir.ui.view">
        <field name="name">fms.report.meter.variance.list</field>
        <field name="model">fms.report.meter.variance</field>
        <field name="arch" type="xml">
            <list string="Meter Variance Log" create="false" edit="false" delete="false"
                  default_order="shift_date desc, pump_name, nozzle_name"
                  decoration-danger="variance_pct &gt; 1 or variance_pct &lt; -1"
                  decoration-warning="(variance_pct &gt; 0.5 or variance_pct &lt; -0.5) and variance_pct &lt;= 1 and variance_pct &gt;= -1">
                <field name="shift_date" string="Date"/>
                <field name="shift_label" string="Period"/>
                <field name="pump_id" string="Pump"/>
                <field name="nozzle_id" string="Nozzle"/>
                <field name="attendant_id" string="Attendant"/>
                <field name="product_id" string="Product"/>
                <field name="qty_sold_elec" string="Elec (L)" sum="Total Elec"/>
                <field name="qty_sold_man" string="Manual (L)" sum="Total Manual"/>
                <field name="variance_l" string="Variance (L)"
                       decoration-danger="variance_l &gt; 10 or variance_l &lt; -10"
                       decoration-warning="(variance_l &gt; 5 or variance_l &lt; -5) and variance_l &lt;= 10 and variance_l &gt;= -10"
                       sum="Total Variance"/>
                <field name="variance_pct" string="Variance %"
                       decoration-danger="variance_pct &gt; 1 or variance_pct &lt; -1"/>
                <field name="rtt_volume" string="RTT (L)" optional="show" sum="Total RTT"/>
                <field name="elec_cash_sold" string="Cash Meter (KES)" optional="show"/>
                <field name="shift_id" string="Shift" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fms_meter_variance_pivot" model="ir.ui.view">
        <field name="name">fms.report.meter.variance.pivot</field>
        <field name="model">fms.report.meter.variance</field>
        <field name="arch" type="xml">
            <pivot string="Meter Variance" disable_linking="false">
                <field name="shift_date" type="row" interval="month"/>
                <field name="nozzle_id" type="row"/>
                <field name="qty_sold_elec" type="measure" string="Elec (L)"/>
                <field name="qty_sold_man" type="measure" string="Manual (L)"/>
                <field name="variance_l" type="measure" string="Variance (L)"/>
            </pivot>
        </field>
    </record>

    <record id="view_fms_meter_variance_graph" model="ir.ui.view">
        <field name="name">fms.report.meter.variance.graph</field>
        <field name="model">fms.report.meter.variance</field>
        <field name="arch" type="xml">
            <graph string="Meter Variance Trend" type="line">
                <field name="shift_date" type="row"/>
                <field name="variance_l" type="measure" string="Variance (L)"/>
            </graph>
        </field>
    </record>

    <record id="view_fms_meter_variance_search" model="ir.ui.view">
        <field name="name">fms.report.meter.variance.search</field>
        <field name="model">fms.report.meter.variance</field>
        <field name="arch" type="xml">
            <search string="Meter Variance">
                <field name="nozzle_id" string="Nozzle"/>
                <field name="attendant_id" string="Attendant"/>
                <field name="product_id" string="Product"/>
                <field name="pump_id" string="Pump"/>
                <filter string="High Variance (&gt;1%)" name="high_variance"
                        domain="[('variance_pct', '&gt;', 1)]"/>
                <filter string="Any Variance (&gt;0.5%)" name="any_variance"
                        domain="[('variance_pct', '&gt;', 0.5)]"/>
                <filter string="This Month" name="this_month"
                        domain="[('shift_date', '&gt;=', context_today() + relativedelta(day=1))]"/>
                <filter string="Last 30 Days" name="last_30"
                        domain="[('shift_date', '&gt;=', context_today() + relativedelta(days=-30))]"/>
                <separator/>
                <group string="Group By">
                    <filter string="Nozzle" name="group_nozzle" context="{'group_by': 'nozzle_id'}"/>
                    <filter string="Pump" name="group_pump" context="{'group_by': 'pump_id'}"/>
                    <filter string="Attendant" name="group_attendant" context="{'group_by': 'attendant_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'shift_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fms_meter_variance" model="ir.actions.act_window">
        <field name="name">Meter Variance Log</field>
        <field name="res_model">fms.report.meter.variance</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_last_30': 1, 'search_default_group_nozzle': 1}</field>
    </record>

    <menuitem id="menu_fms_report_meter_variance"
              name="Meter Variance Log"
              parent="menu_fms_section_wetstock"
              action="action_fms_meter_variance"
              sequence="30"/>


    <!-- ================================================================
         R10 · Attribution Residuals
    ================================================================ -->

    <record id="view_fms_residual_exception_list" model="ir.ui.view">
        <field name="name">fms.report.residual.exception.list</field>
        <field name="model">fms.report.residual.exception</field>
        <field name="arch" type="xml">
            <list string="Attribution Residuals" create="false" edit="false" delete="false"
                  default_order="shift_date desc"
                  decoration-danger="not is_allocated"
                  decoration-muted="is_allocated">
                <field name="shift_date" string="Date"/>
                <field name="shift_label" string="Period"/>
                <field name="supervisor_id" string="Supervisor"/>
                <field name="product_id" string="Product"/>
                <field name="residual_type" string="Type"
                       decoration-warning="residual_type == 'over'"
                       decoration-danger="residual_type == 'under'"/>
                <field name="meter_volume" string="Meter (L)" sum="Total Meter"/>
                <field name="volume_residual" string="Volume Residual (L)"
                       decoration-danger="volume_residual &gt; 50 or volume_residual &lt; -50"
                       sum="Total Volume Residual"/>
                <field name="cash_residual" string="Cash Residual (KES)"
                       decoration-danger="cash_residual &gt; 5000 or cash_residual &lt; -5000"
                       sum="Total Cash Residual"/>
                <field name="is_allocated" string="Allocated" widget="boolean"/>
                <field name="shift_id" string="Shift" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_fms_residual_exception_pivot" model="ir.ui.view">
        <field name="name">fms.report.residual.exception.pivot</field>
        <field name="model">fms.report.residual.exception</field>
        <field name="arch" type="xml">
            <pivot string="Attribution Residuals">
                <field name="shift_date" type="row" interval="month"/>
                <field name="product_id" type="col"/>
                <field name="volume_residual" type="measure"/>
                <field name="cash_residual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_fms_residual_exception_search" model="ir.ui.view">
        <field name="name">fms.report.residual.exception.search</field>
        <field name="model">fms.report.residual.exception</field>
        <field name="arch" type="xml">
            <search string="Attribution Residuals">
                <field name="product_id"/>
                <field name="supervisor_id"/>
                <filter string="Unallocated" name="unallocated"
                        domain="[('is_allocated', '=', False)]"/>
                <filter string="Under-invoiced" name="under"
                        domain="[('residual_type', '=', 'under')]"/>
                <filter string="Over-invoiced" name="over"
                        domain="[('residual_type', '=', 'over')]"/>
                <filter string="This Month" name="this_month"
                        domain="[('shift_date', '&gt;=', context_today() + relativedelta(day=1))]"/>
                <separator/>
                <group string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'residual_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'shift_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fms_residual_exception" model="ir.actions.act_window">
        <field name="name">Attribution Residuals</field>
        <field name="res_model">fms.report.residual.exception</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_unallocated': 1}</field>
    </record>

    <menuitem id="menu_fms_report_residuals"
              name="Attribution Residuals"
              parent="menu_fms_section_cash_credit"
              action="action_fms_residual_exception"
              sequence="20"
              groups="fms.group_fms_supervisor"/>


